  "shortcuts": [
    {
      "name": "Explore Boarding Houses",
      "short_name": "Explore",
      "description": "Browse accredited dorms and boarding houses",
      "url": "/#exploreSection",
      "icons": [
        {
          "src": "/icons/icon-96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Interactive Map",
      "short_name": "Map",
      "description": "Open OSM map to find boarding houses nearby",
      "url": "/#mapSection",
      "icons": [
        {
          "src": "/icons/icon-96.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "categories": [
    "lifestyle",
    "utilities",
    "navigation"
