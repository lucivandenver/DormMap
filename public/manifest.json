{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/?source=pwa",
  "name": "DormMap",
  "short_name": "DormMap",
  "description": "DormMap - Official BPLO Dormitory Finder for the Municipality of Bongabong. Find accredited dorms and boarding houses.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#ffffff",
  "theme_color": "#007a64",
  "orientation": "any",
  "dir": "ltr",
  "lang": "en-PH",
  "icons": [
    {
      "src": "/images/dormmap-circle.png",
      "sizes": "647x643",
      "type": "image/png",
      "purpose": "any"
    },
