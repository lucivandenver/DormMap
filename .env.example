DB_NAME=DorMap
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_DIALECT=mysql
DB_SSL=false
# Aiven: DB_SSL=true, plus the CA contents OR a path to the downloaded CA.
DB_SSL_CA=
DB_SSL_CA_PATH=
NODE_ENV=development
PORT=3000
SESSION_SECRET=
# Blank uses public/uploads locally. Render disk: /var/data/uploads
UPLOAD_DIR=
APP_URL=http://localhost:3000
GEMINI_API_KEY=your-gemini-api-key

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Gmail SMTP Configuration
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-16-digit-app-password
EMAIL_FROM="DorMap <your-email@gmail.com>"

# PayMongo Payment Gateway Configuration (GCash Integration)
PAYMONGO_SECRET_KEY=sk_test_your_paymongo_secret_key_here
PAYMONGO_PUBLIC_KEY=pk_test_your_paymongo_public_key_here
PAYMONGO_WEBHOOK_SECRET_KEY=whsk_your_paymongo_webhook_secret_key_here
PAYMONGO_API_BASE_URL=https://api.paymongo.com/v1
APP_BASE_URL=http://localhost:3000
PAYMENT_SUCCESS_URL=http://localhost:3000/payments/processing
PAYMENT_FAILURE_URL=http://localhost:3000/payments/failure
