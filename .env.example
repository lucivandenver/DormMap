DB_NAME=DorMap
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_DIALECT=mysql
DB_SSL=false
# Aiven: DB_SSL=true, plus the CA contents OR a path to the downloaded CA.
DB_SSL_CA=
DB_SSL_CA_PATH=
NODE_ENV=development
PORT=3000
SESSION_SECRET=
# Blank uses public/uploads locally. Render disk: /var/data/uploads
UPLOAD_DIR=
# true requires a writable configured directory; false permits temporary fallback.
UPLOAD_DIR_STRICT=false
APP_URL=http://localhost:3000
GEMINI_API_KEY=your-gemini-api-key

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Gmail SMTP Configuration
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-16-digit-app-password
# SMTP verification email, when enabled
EMAIL_FROM="DormMap <your-email@gmail.com>"
# Password reset uses the Gmail API over HTTPS. Authorize bplobongabongmunicipality@gmail.com with the gmail.send scope.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# PayMongo QR Ph hosted checkout
PAYMONGO_SECRET_KEY=sk_test_your_paymongo_secret_key_here
PAYMONGO_PUBLIC_KEY=pk_test_your_paymongo_public_key_here
PAYMONGO_WEBHOOK_SECRET_KEY=whsk_your_paymongo_webhook_secret_key_here
PAYMONGO_API_BASE_URL=https://api.paymongo.com/v1
APP_BASE_URL=http://localhost:3000

# Optional Photon-compatible place lookup. Override with your own instance for heavier traffic.
MAP_GEOCODING_URL=https://photon.komoot.io/api/

# Explicit Google admin provisioning; comma-separated verified Google email addresses.
# Set this only in your private environment, never from a public registration form.
ADMIN_GOOGLE_EMAILS=

# Optional browser-restricted MapTiler key for higher-resolution Satellite imagery
MAPTILER_PUBLIC_KEY=

# Optional CARTO Basemaps key used by the browser for the Voyager map layer
CARTO_BASEMAP_KEY=
