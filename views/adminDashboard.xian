{{> head}}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<body class="bg-slate-100 text-slate-800">
<div class="min-h-screen" id="adminApp">
  <!-- Top Navigation Header -->
  <header class="fixed inset-x-0 top-0 z-40 flex h-16 items-center justify-between border-b border-slate-200 bg-white/95 px-4 backdrop-blur lg:px-6 shadow-xs">
    <div class="flex items-center gap-3">
      <button id="menuToggle" class="rounded-lg p-2 text-slate-700 hover:bg-slate-100 transition lg:hidden" aria-label="Toggle Navigation">
        <svg class="icon-bw" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <a href="/" class="flex items-center gap-3 font-bold text-slate-900 group">
        <div class="h-10 w-10 rounded-full overflow-hidden border border-emerald-100 bg-white shadow-xs flex items-center justify-center shrink-0">
          <img src="/images/dormmap-logo.png" alt="DormMap Logo" class="h-full w-full object-contain p-0.5">
        </div>
        <div>
          <span class="text-base font-extrabold text-slate-900 tracking-tight flex items-center gap-1.5">
            DormMap
            <span class="rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5">BPLO</span>
          </span>
          <span class="block text-[11px] font-semibold text-slate-500 -mt-0.5">Super Admin Administration</span>
        </div>
      </a>
    </div>
    <div class="flex items-center gap-3">
      <div id="maintModeBadge" class="hidden items-center gap-1.5 rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-800 border border-amber-300">
        <span class="h-2 w-2 rounded-full bg-amber-500 animate-pulse"></span>
        Maintenance Mode ON
      </div>
      <button id="themeToggle" class="flex items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-100 transition">
        <svg class="icon-bw-sm" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        <span class="hidden sm:inline">Theme</span>
      </button>
      <div class="flex items-center gap-2 border-l border-slate-200 pl-3">
        <div class="flex h-8 w-8 items-center justify-center rounded-full bg-emerald-900 text-white font-bold text-xs uppercase shadow-xs">
          {{userName.[0]}}
        </div>
        <div class="hidden text-left sm:block">
          <p class="text-xs font-bold text-slate-800 leading-tight">{{userName}}</p>
          <p class="text-[10px] text-emerald-700 font-semibold">BPLO Super Admin</p>
        </div>
        <a href="/logout" class="ml-2 flex items-center gap-1.5 rounded-lg bg-rose-50 px-3 py-1.5 text-xs font-semibold text-rose-700 hover:bg-rose-100 transition">
          <svg class="icon-bw-sm" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Logout
        </a>
      </div>
    </div>
  </header>

  <!-- Sidebar Navigation -->
  <aside id="sidebar" class="fixed inset-y-16 left-0 z-30 w-64 -translate-x-full overflow-y-auto border-r border-slate-200 bg-white p-3 transition-transform duration-200 lg:translate-x-0">
    <div class="px-3 py-2 border-b border-slate-100 pb-3 mb-2">
      <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Administration Portal</p>
      <h2 class="text-sm font-bold text-emerald-950 truncate">BPLO Bongabong</h2>
    </div>

    <nav id="adminNav" class="space-y-4">
      <!-- Group 1: OVERVIEW & GIS -->
      <div>
        <p class="px-3 text-[10px] font-black uppercase tracking-wider text-slate-400 mb-1.5">Overview & Geolocation</p>
        <div class="space-y-0.5">
          <button data-panel="overview" class="nav-item active">
            <svg width="18" height="18" class="icon-bw w-4.5 h-4.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
            <span>Dashboard Overview</span>
          </button>
          <button data-panel="gis_map" class="nav-item">
            <svg width="18" height="18" class="icon-bw w-4.5 h-4.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Municipal GIS Map</span>
            <span class="ml-auto rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5">GIS</span>
          </button>
        </div>
      </div>

      <hr class="border-slate-100 my-2" />

      <!-- Group 2: TWO-WAY DATA MANAGEMENT -->
      <div>
        <p class="px-3 text-[10px] font-black uppercase tracking-wider text-slate-400 mb-1.5">Barangay Data Management</p>
        <div class="space-y-0.5">
          <button data-panel="data_requests" class="nav-item">
            <svg width="18" height="18" class="icon-bw w-4.5 h-4.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <span>Data Requests Hub</span>
          </button>
          <button data-panel="submissions" class="nav-item">
            <svg width="18" height="18" class="icon-bw w-4.5 h-4.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            <span>Barangay Submissions</span>
          </button>
        </div>
      </div>

      <hr class="border-slate-100 my-2" />

      <!-- Group 3: MUNICIPAL & PERMITS -->
      <div>
        <p class="px-3 text-[10px] font-black uppercase tracking-wider text-slate-400 mb-1.5">Municipal & Permits</p>
        <div class="space-y-0.5">
          <button data-panel="owners" class="nav-item">
            <svg width="18" height="18" class="icon-bw w-4.5 h-4.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/></svg>
            <span>Owner Applications</span>
          </button>
          <button data-panel="renewals" class="nav-item">
            <svg width="18" height="18" class="icon-bw w-4.5 h-4.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
            <span>Permit Renewals</span>
          </button>
          <button data-panel="barangays" class="nav-item">
            <svg width="18" height="18" class="icon-bw w-4.5 h-4.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Barangays</span>
          </button>
          <button data-panel="institutions" class="nav-item">
            <svg width="18" height="18" class="icon-bw w-4.5 h-4.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 22V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v18"/><path d="M18 22V8a2 2 0 0 0-2-2h-2"/><path d="M6 12h4"/><path d="M6 16h4"/></svg>
            <span>Educational Institutions</span>
          </button>
          <button data-panel="permits" class="nav-item">
            <svg width="18" height="18" class="icon-bw w-4.5 h-4.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
            <span>Business Permits</span>
          </button>
        </div>
      </div>

      <hr class="border-slate-100 my-2" />

      <!-- Group 4: SYSTEM ADMINISTRATION & MONITORING -->
      <div>
        <p class="px-3 text-[10px] font-black uppercase tracking-wider text-slate-400 mb-1.5">System Administration</p>
        <div class="space-y-0.5">
          <button data-panel="settings" class="nav-item">
            <svg width="18" height="18" class="icon-bw w-4.5 h-4.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            <span>System Settings</span>
          </button>
          <button data-panel="maintenance" class="nav-item">
            <svg width="18" height="18" class="icon-bw w-4.5 h-4.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
            <span>System Maintenance</span>
          </button>
          <button data-panel="announcements" class="nav-item">
            <svg width="18" height="18" class="icon-bw w-4.5 h-4.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="m3 11 18-5v12L3 13v-2z"/><path d="M11.6 16.8 a3 3 0 1 1-5.8-1.6"/></svg>
            <span>Announcements</span>
          </button>
          <button data-panel="audit" class="nav-item">
            <svg width="18" height="18" class="icon-bw w-4.5 h-4.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>Audit Logs</span>
          </button>
        </div>
      </div>
    </nav>
  </aside>

  <!-- Main Content Area -->
  <main class="px-4 pb-12 pt-20 lg:ml-64 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <!-- Section Header -->
      <div class="mb-7 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-emerald-700">BPLO SUPER ADMIN PORTAL</p>
          <h1 id="pageTitle" class="mt-1 text-2xl font-bold text-slate-950 sm:text-3xl">Municipal Overview</h1>
          <p id="pageDesc" class="mt-1 text-sm text-slate-500">Monitor applications, establishments, permits, data requests, and system health.</p>
        </div>
      </div>

      <!-- VIEW 1: OVERVIEW -->
      <section data-view="overview" class="space-y-6">
        <div id="metricCards" class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4"></div>
        <div class="grid gap-6 xl:grid-cols-5">
          <section class="rounded-2xl bg-white p-5 shadow-xs border border-slate-100 xl:col-span-3">
            <div class="flex items-center justify-between">
              <h2 class="font-bold text-slate-900">Monthly Registrations</h2>
              <span class="text-xs text-slate-400">Last 6 Months</span>
            </div>
            <div id="registrationChart" class="mt-5 flex h-48 items-end gap-3"></div>
          </section>
          <section class="rounded-2xl bg-white p-5 shadow-xs border border-slate-100 xl:col-span-2">
            <h2 class="font-bold text-slate-900">Permit Status Summary</h2>
            <div id="permitChart" class="mt-5 space-y-3"></div>
          </section>
        </div>
        <section class="rounded-2xl bg-white p-5 shadow-xs border border-slate-100">
          <h2 class="font-bold text-slate-900">Recent Administrative Activity</h2>
          <div id="recentActivity" class="mt-4 divide-y divide-slate-100"></div>
        </section>
      </section>

      <!-- VIEW: MUNICIPAL GIS MAP -->
      <section data-view="gis_map" class="hidden space-y-5">
        <!-- Top Controls Toolbar -->
        <div class="rounded-2xl bg-white p-4 shadow-xs border border-slate-100 flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap items-center gap-2.5 flex-1 min-w-[280px]">
            <div class="relative flex-1 min-w-[220px] max-w-md">
              <input id="gisSearchInput" class="field !pl-4" placeholder="Search boarding house, owner, or barangay...">
            </div>
            <select id="gisTypeFilter" class="field !w-44">
              <option value="all">All Pinpoints</option>
              <option value="owner">🏠 Boarding Houses</option>
              <option value="official">🏛️ Barangay Officials</option>
            </select>
            <select id="gisStatusFilter" class="field !w-40">
              <option value="all">All Statuses</option>
              <option value="approved">Approved / Active</option>
              <option value="pending">Pending</option>
              <option value="suspended">Suspended</option>
            </select>
            <select id="gisBarangayFilter" class="field !w-44">
              <option value="">All 36 Barangays</option>
            </select>
            <button class="button flex items-center gap-1.5 !bg-emerald-700 !text-white !border-emerald-800 hover:!bg-emerald-800" onclick="applyGisFilters()">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 21l-4.35-4.35"/><circle cx="11" cy="11" r="8"/></svg>
              Filter
            </button>
            <button class="button secondary text-xs" onclick="resetGisFilters()">Reset</button>
          </div>

          <div class="flex items-center gap-3 text-xs font-semibold text-slate-600 bg-slate-50 px-3.5 py-2 rounded-xl border border-slate-200">
            <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-emerald-600"></span> Active House</span>
            <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-amber-500"></span> Pending House</span>
            <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-rose-600"></span> Suspended</span>
            <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-teal-600"></span> Barangay Official</span>
          </div>
        </div>

        <!-- Geospatial Statistics Bar -->
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
          <div class="rounded-xl bg-white p-3.5 border border-slate-100 shadow-xs flex items-center gap-3">
            <div class="h-9 w-9 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center font-bold text-base">🏠</div>
            <div>
              <p id="gisStatHouses" class="text-lg font-bold text-slate-900 leading-tight">0</p>
              <p class="text-[11px] font-medium text-slate-500">Boarding Houses</p>
            </div>
          </div>
          <div class="rounded-xl bg-white p-3.5 border border-slate-100 shadow-xs flex items-center gap-3">
            <div class="h-9 w-9 rounded-lg bg-teal-50 text-teal-700 flex items-center justify-center font-bold text-base">🏛️</div>
            <div>
              <p id="gisStatOfficials" class="text-lg font-bold text-slate-900 leading-tight">0</p>
              <p class="text-[11px] font-medium text-slate-500">Barangay Officials</p>
            </div>
          </div>
          <div class="rounded-xl bg-white p-3.5 border border-slate-100 shadow-xs flex items-center gap-3">
            <div class="h-9 w-9 rounded-lg bg-blue-50 text-blue-700 flex items-center justify-center font-bold text-base">🛏️</div>
            <div>
              <p id="gisStatRooms" class="text-lg font-bold text-slate-900 leading-tight">0</p>
              <p class="text-[11px] font-medium text-slate-500">Available Rooms</p>
            </div>
          </div>
          <div class="rounded-xl bg-white p-3.5 border border-slate-100 shadow-xs flex items-center gap-3">
            <div class="h-9 w-9 rounded-lg bg-purple-50 text-purple-700 flex items-center justify-center font-bold text-base">📍</div>
            <div>
              <p id="gisStatActivePins" class="text-lg font-bold text-slate-900 leading-tight">0</p>
              <p class="text-[11px] font-medium text-slate-500">Visible Pins on Map</p>
            </div>
          </div>
        </div>

        <!-- Full Map Container -->
        <div class="relative rounded-2xl bg-white p-3 shadow-xs border border-slate-100">
          <div class="mb-2 flex items-center justify-between px-2">
            <div>
              <h2 class="font-bold text-slate-900">Bongabong Geospatial Establishments & Official Locations</h2>
              <p class="text-xs text-slate-500">OpenStreetMap live pinpoints with quick inspector and jurisdiction markers</p>
            </div>
            <button class="button secondary text-xs flex items-center gap-1.5 py-1.5 px-3" onclick="loadGisMap()">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
              Refresh Pins
            </button>
          </div>
          <div id="adminGisMap" class="h-[620px] w-full rounded-xl border border-slate-200"></div>
        </div>
      </section>

      <!-- VIEW 2: DATA REQUESTS HUB -->
      <section data-view="data_requests" class="hidden space-y-6">
        <div class="toolbar justify-between items-center bg-white p-4 rounded-2xl border border-slate-100 shadow-xs">
          <div class="flex flex-wrap gap-2 items-center">
            <input id="dataReqSearch" class="field !w-64" placeholder="Search request title or purpose...">
            <select id="dataReqPriority" class="field !w-40">
              <option value="">All Priorities</option>
              <option value="urgent">Urgent Priority</option>
              <option value="high">High Priority</option>
              <option value="normal">Normal</option>
            </select>
            <select id="dataReqStatus" class="field !w-36">
              <option value="">All Statuses</option>
              <option value="active">Active</option>
              <option value="completed">Completed</option>
              <option value="cancelled">Cancelled</option>
            </select>
            <button class="button flex items-center gap-1.5" onclick="loadDataRequests()">Search</button>
          </div>
          <button class="button !bg-emerald-700 !text-white !border-emerald-800 flex items-center gap-2 hover:!bg-emerald-800" onclick="openCreateDataRequestModal()">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Create New Data Request
          </button>
        </div>

        <div id="dataRequestsContainer" class="grid gap-4"></div>
      </section>

      <!-- VIEW 3: BARANGAY SUBMISSIONS MANAGEMENT -->
      <section data-view="submissions" class="hidden space-y-6">
        <div class="toolbar justify-between items-center bg-white p-4 rounded-2xl border border-slate-100 shadow-xs">
          <div class="flex flex-wrap gap-2 items-center">
            <input id="submissionSearch" class="field !w-60" placeholder="Search barangay, title...">
            <select id="submissionBarangay" class="field !w-44"><option value="">All Barangays</option></select>
            <select id="submissionStatus" class="field !w-40">
              <option value="">All Statuses</option>
              <option value="submitted">Submitted (New)</option>
              <option value="under_review">Under Review</option>
              <option value="revision_requested">Revision Requested</option>
              <option value="approved">Approved</option>
              <option value="rejected">Rejected</option>
            </select>
            <button class="button flex items-center gap-1.5" onclick="loadSubmissions()">Filter</button>
          </div>
          <div class="flex gap-2">
            <button class="button secondary flex items-center gap-1.5" onclick="openComplianceMatrixModal()">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 3h18v18H3z"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
              Compliance Matrix
            </button>
            <button class="button secondary flex items-center gap-1.5" onclick="exportConsolidatedReports()">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Consolidated Export
            </button>
          </div>
        </div>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Barangay</th>
                <th>Submission Title & Type</th>
                <th>Period</th>
                <th>Attached File</th>
                <th>Summary Metrics</th>
                <th>Status</th>
                <th>Submitted</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="submissionsTable"></tbody>
          </table>
        </div>
      </section>

      <!-- VIEW 4: OWNER APPLICATIONS -->
      <section data-view="owners" class="hidden space-y-6">
        <div class="toolbar bg-white p-4 rounded-2xl border border-slate-100 shadow-xs">
          <input id="ownerSearch" class="field !w-64" placeholder="Search owner, property, email">
          <select id="ownerStatus" class="field !w-44">
            <option value="">All Statuses</option>
            <option value="pending">Pending</option>
            <option value="revision_requested">Revision Requested</option>
            <option value="forwarded_to_bplo">Forwarded by Barangay</option>
            <option value="approved">Approved</option>
            <option value="rejected">Rejected</option>
          </select>
          <button class="button flex items-center gap-1.5" onclick="loadOwners()"><svg class="icon-bw-sm" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>Search</button>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Owner / Property</th>
                <th>Barangay</th>
                <th>Documents</th>
                <th>Status</th>
                <th>Submitted</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="ownersTable"></tbody>
          </table>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border bg-white p-4"><p id="ownerPaginationLabel" class="text-sm text-slate-600"></p><div class="flex gap-2"><button id="ownerPrevPage" class="button secondary" onclick="loadOwners(ownerCurrentPage-1)">Previous</button><button id="ownerNextPage" class="button secondary" onclick="loadOwners(ownerCurrentPage+1)">Next</button></div></div>
      </section>

      <!-- VIEW 5: PERMIT RENEWALS -->
      <section data-view="renewals" class="hidden space-y-6">
        <div class="toolbar bg-white p-4 rounded-2xl border border-slate-100 shadow-xs">
          <select id="renewalStatus" class="field !w-48">
            <option value="">All Renewal Statuses</option>
            <option value="forwarded_to_bplo">Forwarded to BPLO</option>
            <option value="bplo_approved">BPLO Approved</option>
            <option value="revision_required">Revision Required</option>
            <option value="rejected">Rejected</option>
          </select>
          <button class="button flex items-center gap-1.5" onclick="loadPermitRenewals()">Refresh</button>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Establishment / Owner</th>
                <th>Barangay</th>
                <th>Permit Number</th>
                <th>Current Expiry</th>
                <th>Renewal Request Date</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="renewalsTable"></tbody>
          </table>
        </div>
      </section>

      <!-- VIEW 6: BARANGAYS -->
      <section data-view="barangays" class="hidden space-y-6">
        <div class="rounded-2xl border border-emerald-100 bg-white p-5 space-y-4">
          <div class="flex flex-wrap justify-between gap-3"><div><h2 class="text-lg font-bold">Barangay account approvals</h2><p class="text-sm text-slate-500">Review officials before they access their dashboard or receive owner applications.</p></div><button class="button secondary" onclick="loadBarangayAccounts()">Refresh applications</button></div>
          <div class="table-wrap"><table><thead><tr><th>Official</th><th>Barangay / Position</th><th>Status / Note</th><th>Review</th></tr></thead><tbody id="barangayAccountsTable"></tbody></table></div>
        </div>
        <div class="toolbar bg-white p-4 rounded-2xl border border-slate-100 shadow-xs">
          <input id="barangaysSearch" class="field" placeholder="Search barangay">
          <button class="button flex items-center gap-1.5" onclick="openRecordForm('barangays')"><svg class="icon-bw-sm" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>Add Barangay</button>
          <button class="button secondary flex items-center gap-1.5" onclick="loadCollection('barangays')">Refresh</button>
        </div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Barangay</th><th>Assigned Official</th><th>Official Email</th><th>Status</th><th>Action</th></tr></thead>
            <tbody id="barangaysTable"></tbody>
          </table>
        </div>
      </section>

      <!-- VIEW 7: INSTITUTIONS -->
      <section data-view="institutions" class="hidden space-y-6">
        <div class="toolbar bg-white p-4 rounded-2xl border border-slate-100 shadow-xs">
          <input id="institutionsSearch" class="field" placeholder="Search institution">
          <button class="button flex items-center gap-1.5" onclick="openRecordForm('institutions')"><svg class="icon-bw-sm" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>Add Institution</button>
          <button class="button secondary flex items-center gap-1.5" onclick="loadCollection('institutions')">Refresh</button>
        </div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Name</th><th>Type</th><th>Barangay</th><th>Coordinates</th><th>Action</th></tr></thead>
            <tbody id="institutionsTable"></tbody>
          </table>
        </div>
      </section>

      <!-- VIEW 8: PERMITS -->
      <section data-view="permits" class="hidden space-y-6">
        <div class="toolbar bg-white p-4 rounded-2xl border border-slate-100 shadow-xs">
          <button class="button flex items-center gap-1.5" onclick="openRecordForm('permits')"><svg class="icon-bw-sm" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>Record Permit</button>
          <button class="button secondary flex items-center gap-1.5" onclick="loadCollection('permits')">Refresh</button>
        </div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Permit No.</th><th>Owner ID</th><th>Expires</th><th>Status</th><th>Action</th></tr></thead>
            <tbody id="permitsTable"></tbody>
          </table>
        </div>
      </section>

      <!-- VIEW 9: SYSTEM SETTINGS & CONFIGURATION -->
      <section data-view="settings" class="hidden space-y-6">
        <div class="rounded-2xl bg-white p-6 shadow-xs border border-slate-100">
          <h2 class="text-lg font-bold text-slate-900 mb-2">System Settings & Configuration</h2>
          <p class="text-xs text-slate-500 mb-6">Manage municipality parameters, reporting schedules, notification intervals, and file upload limits.</p>
          <form id="systemSettingsForm" class="space-y-4 max-w-2xl">
            <div id="settingsFieldsContainer" class="space-y-4"></div>
            <button class="button !bg-emerald-700 !text-white mt-4 flex items-center gap-2">
              Save All Settings
            </button>
          </form>
        </div>
      </section>

      <!-- VIEW 10: SYSTEM MAINTENANCE & MONITORING -->
      <section data-view="maintenance" class="hidden space-y-6">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" id="maintenanceStatusCards"></div>
        <div class="grid gap-6 lg:grid-cols-2">
          <div class="rounded-2xl bg-white p-6 shadow-xs border border-slate-100 space-y-4">
            <h3 class="font-bold text-slate-900">Maintenance Mode & Operations</h3>
            <p class="text-xs text-slate-500">Put the portal in maintenance mode to prevent non-admin users from accessing or modifying records.</p>
            <div class="flex items-center gap-4 pt-2">
              <button id="toggleMaintBtn" class="button flex items-center gap-2" onclick="toggleMaintenance()">
                Toggle Maintenance Mode
              </button>
              <button class="button secondary flex items-center gap-2" onclick="downloadDatabaseBackup()">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Generate Database Backup
              </button>
            </div>
          </div>
          <div class="rounded-2xl bg-white p-6 shadow-xs border border-slate-100 space-y-4">
            <h3 class="font-bold text-slate-900">System Logs & Events</h3>
            <p class="text-xs text-slate-500">Monitor active processes, server health, and security events.</p>
            <div id="quickLogsPreview" class="text-xs font-mono bg-slate-950 text-emerald-400 p-4 rounded-xl max-h-40 overflow-y-auto space-y-1"></div>
          </div>
        </div>
      </section>

      <!-- VIEW 11: ANNOUNCEMENTS -->
      <section data-view="announcements" class="hidden space-y-6">
        <div class="max-w-2xl rounded-2xl bg-white p-6 shadow-xs border border-slate-100">
          <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
            <svg class="w-5 h-5 shrink-0 text-slate-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m3 11 18-5v12L3 13v-2z"/><path d="M11.6 16.8 a3 3 0 1 1-5.8-1.6"/></svg>
            Broadcast Official Announcement
          </h2>
          <form id="announcementForm" class="mt-5 space-y-4">
            <input name="title" class="field" placeholder="Announcement Title (e.g., Mandatory Q1 Masterlist Submission)" required>
            <textarea name="message" class="field min-h-32" placeholder="Announcement Message" required></textarea>
            <select name="audience" class="field">
              <option value="all">All Users (Barangay, Owners, Tenants)</option>
              <option value="barangay">Barangay Officials Only</option>
              <option value="boarding_house_owner">Boarding House Owners Only</option>
              <option value="tenant">Tenants Only</option>
            </select>
            <button class="button !bg-emerald-700 !text-white flex items-center gap-1.5">
              Broadcast Announcement
            </button>
          </form>
        </div>
      </section>

      <!-- VIEW 12: AUDIT LOGS -->
      <section data-view="audit" class="hidden space-y-6">
        <div class="table-wrap">
          <table>
            <thead><tr><th>Timestamp</th><th>Action</th><th>Entity</th><th>Actor ID</th><th>IP Address</th></tr></thead>
            <tbody id="auditTable"></tbody>
          </table>
        </div>
      </section>
    </div>
  </main>
</div>

<!-- MODAL: CREATE DATA REQUEST -->
<div id="createDataRequestModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/60 p-4 backdrop-blur-xs">
  <div class="w-full max-w-2xl rounded-2xl bg-white p-6 shadow-2xl max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between border-b pb-3 mb-4">
      <h2 class="text-lg font-bold text-slate-900">Create BPLO Data Request</h2>
      <button onclick="closeModal('createDataRequestModal')" class="text-slate-400 hover:text-slate-700">✕</button>
    </div>
    <form id="createDataRequestForm" class="space-y-4">
      <div>
        <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Request Title</label>
        <input name="title" class="field" placeholder="e.g., Q1 2026 Boarding House Masterlist & Permit Compliance" required>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Category</label>
          <select name="category" class="field">
            <option value="updated_masterlist">Updated Boarding House Masterlist</option>
            <option value="unregistered_houses">Unregistered Boarding Houses</option>
            <option value="permit_renewals">Permit Renewal Status</option>
            <option value="expired_permits">Expired / Expiring Permits</option>
            <option value="occupancy_tenants">Room & Tenant Occupancy</option>
            <option value="new_establishments">Newly Discovered Establishments</option>
            <option value="closed_establishments">Closed / Inactive Establishments</option>
            <option value="ownership_changes">Ownership Changes</option>
            <option value="location_changes">Location Changes</option>
            <option value="general_compliance">General Municipal Compliance</option>
            <option value="other">Other Information</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Priority Level</label>
          <select name="priority" class="field">
            <option value="normal">Normal</option>
            <option value="high">High Priority</option>
            <option value="urgent">URGENT</option>
          </select>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Reporting Period</label>
          <select name="reportingPeriod" class="field">
            <option value="monthly">Monthly Report</option>
            <option value="quarterly">Quarterly Report</option>
            <option value="semi_annual">Semi-Annual Report</option>
            <option value="yearly">Yearly / Annual Report</option>
            <option value="on_demand">On-Demand / Immediate</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Submission Deadline</label>
          <input type="date" name="submissionDeadline" class="field" required>
        </div>
      </div>
      <div>
        <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Target Barangays</label>
        <select name="targetType" id="dataReqTargetType" class="field" onchange="toggleBarangaySelection(this.value)">
          <option value="all_barangays">All 28 Barangays</option>
          <option value="selected_barangays">Selected Barangays Only</option>
        </select>
        <div id="selectedBarangaysBox" class="hidden mt-2 p-3 border rounded-xl bg-slate-50 max-h-36 overflow-y-auto grid grid-cols-2 sm:grid-cols-3 gap-2"></div>
      </div>
      <div>
        <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Purpose of Request</label>
        <textarea name="purpose" class="field min-h-20" placeholder="State the official purpose (e.g., Annual BPLO audit and masterlist synchronization)..." required></textarea>
      </div>
      <div>
        <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Required File Formats & Instructions</label>
        <input name="requiredFormat" class="field mb-2" value="PDF, XLSX, CSV" placeholder="e.g. PDF, XLSX, CSV">
        <textarea name="instructions" class="field min-h-16" placeholder="Specific instructions for barangay officials..."></textarea>
      </div>
      <div class="flex justify-end gap-2 pt-3 border-t">
        <button type="button" class="button secondary" onclick="closeModal('createDataRequestModal')">Cancel</button>
        <button type="submit" class="button !bg-emerald-700 !text-white">Create & Broadcast Request</button>
      </div>
    </form>
  </div>
</div>

