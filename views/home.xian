{{> head }}
<script src="/js/landing-search.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <style>
    :root {
      --dormmap-primary: #023020;
      --dormmap-primary-soft: #084d34;
      --dormmap-accent: #f4b400;
      --dormmap-surface: rgba(255, 255, 255, 0.82);
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Inter', sans-serif;
      background:
        radial-gradient(circle at top left, rgba(2, 48, 32, 0.08), transparent 34%),
        radial-gradient(circle at bottom right, rgba(2, 48, 32, 0.06), transparent 28%),
        #f8fafc;
      color: #1f2937;
    }

    .font-display {
      font-family: 'Poppins', sans-serif;
    }

    .glass-card {
      background: var(--dormmap-surface);
      backdrop-filter: blur(18px);
      border: 1px solid rgba(2, 48, 32, 0.08);
      box-shadow: 0 24px 60px rgba(15, 23, 42, 0.08);
    }

    .section-shell {
      position: relative;
    }

    .section-shell::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(255,255,255,0.35), transparent);
      pointer-events: none;
    }

    .nav-scrolled {
      background: rgba(255, 255, 255, 0.96);
      box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
      border-bottom: 1px solid rgba(2, 48, 32, 0.06);
    }

    .nav-link {
      position: relative;
      display: inline-flex;
      align-items: center;
      padding-bottom: 0.2rem;
      transition: color 180ms ease;
    }

    .nav-link::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: -0.2rem;
      width: 100%;
      height: 2px;
      border-radius: 999px;
      background: var(--dormmap-primary);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 180ms ease;
    }

    .nav-link:hover::after,
    .nav-link:focus-visible::after {
      transform: scaleX(1);
    }

    .nav-link:hover,
    .nav-link:focus-visible {
      color: var(--dormmap-primary);
    }

    .map-frame {
      min-height: 420px;
    }

    @media (max-width: 768px) {
      .map-frame {
        min-height: 340px;
      }
    }

    #detailCarouselTrack {
      display: flex;
      height: 100%;
      width: 100%;
      transition: transform 320ms cubic-bezier(0.25, 1, 0.5, 1);
    }
    .detail-carousel-dot {
      transition: all 200ms ease;
    }
  </style>
</head>
<body class="antialiased text-slate-800">
  <header id="siteHeader" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
    <div class="w-full px-0">
      <div class="border-b border-slate-200 bg-white/95 px-4 py-3 backdrop-blur-xl sm:px-6 lg:px-8">
        <div class="flex items-center justify-between gap-4">
          <a href="#top" class="flex items-center gap-3 min-w-0">
            <div class="flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-full border border-emerald-950/10 bg-white shadow-sm">
              <svg viewBox="0 0 64 64" class="h-full w-full" aria-hidden="true">
                <defs>
                  <linearGradient id="dormmapLogoBlue" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#1e4f8f" />
                    <stop offset="100%" stop-color="#113a73" />
                  </linearGradient>
                  <linearGradient id="dormmapLogoGreen" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#77c84b" />
                    <stop offset="100%" stop-color="#2d9a4a" />
                  </linearGradient>
                </defs>
                <circle cx="32" cy="32" r="30" fill="white" stroke="url(#dormmapLogoBlue)" stroke-width="2.5" />
                <path d="M15 30h10V18H15z" fill="url(#dormmapLogoBlue)" opacity="0.9" />
                <path d="M13 30h12v16H13z" fill="#2f6fa8" opacity="0.96" />
                <path d="M39 14l11 6v20H39z" fill="url(#dormmapLogoGreen)" opacity="0.94" />
                <path d="M48 28l6 4v10h-6z" fill="#6bc94f" opacity="0.96" />
                <path d="M20 33l12-10 12 10v14H20z" fill="white" stroke="url(#dormmapLogoBlue)" stroke-width="2.2" stroke-linejoin="round" />
                <path d="M26 40h4v7h-4zM34 40h4v7h-4z" fill="url(#dormmapLogoBlue)" />
                <path d="M24 49h16" stroke="url(#dormmapLogoBlue)" stroke-width="2.2" stroke-linecap="round" />
                <path d="M32 47c-2.9 0-5.2 2.3-5.2 5.1 0 3.8 5.2 9.1 5.2 9.1s5.2-5.3 5.2-9.1c0-2.8-2.3-5.1-5.2-5.1z" fill="url(#dormmapLogoBlue)" />
                <circle cx="32" cy="52" r="1.8" fill="white" />
                <path d="M35 21h4v8h-4zM41 21h4v8h-4zM35 31h4v8h-4zM41 31h4v8h-4z" fill="rgba(255,255,255,0.9)" />
                <path d="M15 46c3.5-1 7.1-1.2 10.6-.4M39 46c3.6-.1 7.1.5 10.5 1.8" stroke="rgba(17,58,115,0.18)" stroke-width="2" stroke-linecap="round" />
              </svg>
            </div>
            <div class="min-w-0">
              <div class="font-display text-base font-extrabold tracking-tight text-slate-900 sm:text-lg">DormMap</div>
              <p class="truncate text-xs font-medium uppercase tracking-[0.18em] text-slate-500">Official BPLO Dormitory Finder</p>
            </div>
          </a>

          <nav class="hidden items-center gap-7 text-sm font-medium text-slate-700 lg:flex">
            <a href="#top" class="nav-link">Home</a>
            <a href="#search" class="nav-link">Find Housing</a>
            <a href="#map" class="nav-link">Map</a>
            <a href="/about" class="nav-link">About</a>
            <a href="#contact" class="nav-link">Contact</a>
          </nav>

          <div class="flex items-center gap-2 sm:gap-3">
            <!-- Language Selector Dropdown Container (Image 2 Minimalist Design) -->
            <div class="relative inline-block text-left" id="langDropdownContainer">
              <button type="button" id="headerLangBtn" onclick="toggleLanguageDropdown(event)" title="Select Language" class="inline-flex items-center gap-2.5 rounded-2xl bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-xs border border-slate-200/80 hover:bg-slate-50 transition cursor-pointer">
                <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/><path d="M2 12h20"/>
                </svg>
                <span class="current-lang-display font-medium text-slate-700">English</span>
              </button>

              <!-- Image 2 Minimal Floating Dropdown Card -->
              <div id="langDropdownMenu" class="hidden absolute right-0 mt-2 w-56 sm:w-64 max-h-80 overflow-y-auto rounded-2xl bg-white shadow-xl border border-slate-100 py-1 z-50 divide-y divide-slate-100/60 animate-in fade-in zoom-in-95 duration-150">
              </div>
            </div>

            <div class="hidden items-center gap-3 lg:flex">
              <a href="/login" class="rounded-full border border-emerald-950/10 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-[var(--dormmap-primary)] hover:text-[var(--dormmap-primary)]">Login</a>
              <a href="/register" class="rounded-full px-4 py-2 text-sm font-semibold text-white shadow-lg transition hover:opacity-95" style="background: var(--dormmap-primary);">Register</a>
            </div>

            <button id="mobileMenuButton" type="button" class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-emerald-950/10 text-slate-800 transition hover:border-[var(--dormmap-primary)] hover:text-[var(--dormmap-primary)] lg:hidden" aria-label="Open menu">
              <i data-lucide="menu" class="h-5 w-5"></i>
            </button>
          </div>
        </div>

        <div id="mobileMenu" class="mt-4 hidden border-t border-emerald-950/10 pt-4 lg:hidden">
          <div class="flex flex-col gap-3 text-sm font-medium text-slate-700">
            <a href="#top" class="rounded-2xl px-3 py-2 transition hover:bg-emerald-950/5">Home</a>
            <a href="#search" class="rounded-2xl px-3 py-2 transition hover:bg-emerald-950/5">Find Housing</a>
            <a href="#map" class="rounded-2xl px-3 py-2 transition hover:bg-emerald-950/5">Map</a>
            <a href="/about" class="rounded-2xl px-3 py-2 transition hover:bg-emerald-950/5">About</a>
            <a href="#contact" class="rounded-2xl px-3 py-2 transition hover:bg-emerald-950/5">Contact</a>
            <div class="relative w-full">
              <button type="button" onclick="toggleLanguageDropdown(event)" class="w-full flex items-center justify-between gap-2.5 rounded-2xl bg-white border border-slate-200 px-4 py-3 text-left font-medium text-slate-700">
                <div class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/><path d="M2 12h20"/>
                  </svg>
                  <span class="text-xs">Language: <strong class="current-lang-display text-slate-900 font-semibold">English</strong></span>
                </div>
                <span class="text-xs text-slate-400">▾</span>
              </button>
            </div>
            <div class="grid grid-cols-2 gap-3 pt-2">
              <a href="/login" class="rounded-full border border-emerald-950/10 px-4 py-2 text-center font-semibold text-slate-700">Login</a>
              <a href="/register" class="rounded-full px-4 py-2 text-center font-semibold text-white" style="background: var(--dormmap-primary);">Register</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main id="top">
    <!-- ===== HERO SECTION — Full-width BG municipality image, light green overlay ===== -->
    <section class="relative min-h-[92vh] flex flex-col justify-center overflow-hidden" style="padding-top: 72px;">
      <!-- Municipality background image -->
      <div class="absolute inset-0 z-0">
        <img
          src="https://tse2.mm.bing.net/th/id/OIP.0ny3bYtW0Hhz4xQfMWEkjwHaEM?r=0&rs=1&pid=ImgDetMain&o=7&rm=3"
          onerror="this.src='/images/bongabong-municipal.jpg'"
          alt="Municipality of Bongabong"
          class="h-full w-full object-cover object-center"
        >
        <!-- Light green gradient overlay -->
        <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(5,120,70,0.82) 0%, rgba(2,48,32,0.75) 40%, rgba(5,100,60,0.60) 100%);"></div>
        <!-- Subtle pattern noise for depth -->
        <div class="absolute inset-0 opacity-10" style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Ccircle cx=\'30\' cy=\'30\' r=\'1\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
      </div>

      <!-- Hero Content -->
      <div class="relative z-10 mx-auto w-full max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">

          <!-- Left: Text Content -->
          <div class="space-y-7">
            <!-- Official badge -->
            <span class="inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/15 px-4 py-2 text-xs font-black uppercase tracking-[0.28em] text-white backdrop-blur-md">
              <img src="https://bongabong.gov.ph/logo.png" onerror="this.src='/images/bongabong-seal.png'" alt="Bongabong Seal" class="h-5 w-5 rounded-full bg-white p-0.5 object-contain">
              Official Municipality of Bongabong
            </span>

            <div class="space-y-5">
              <h1 class="font-display text-4xl font-extrabold leading-[1.1] text-white drop-shadow-md sm:text-5xl lg:text-6xl">
                Find Your Ideal
                <br>
                <span style="color: #a7f3d0;">Boarding House</span>
                <br>
                Near Your School
              </h1>
              <p class="max-w-xl text-base leading-8 text-white/90 sm:text-lg">
                DormMap is the official BPLO dormitory finder for the Municipality of Bongabong. Browse verified listings, compare amenities, and get location-aware boarding house information on any device.
              </p>
            </div>

            <!-- Trust badges inline -->
            <div class="flex flex-wrap gap-3">
              <div class="flex items-center gap-2 rounded-2xl bg-white/15 border border-white/25 px-4 py-2.5 backdrop-blur-md">
                <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-emerald-400/30 text-white">
                  <i data-lucide="badge-check" class="h-4 w-4"></i>
                </span>
                <span class="text-sm font-bold text-white">BPLO Verified</span>
              </div>
              <div class="flex items-center gap-2 rounded-2xl bg-white/15 border border-white/25 px-4 py-2.5 backdrop-blur-md">
                <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-emerald-400/30 text-white">
                  <i data-lucide="shield-check" class="h-4 w-4"></i>
                </span>
                <span class="text-sm font-bold text-white">Safe & Secure</span>
              </div>
              <div class="flex items-center gap-2 rounded-2xl bg-white/15 border border-white/25 px-4 py-2.5 backdrop-blur-md">
                <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-emerald-400/30 text-white">
                  <i data-lucide="map-pin" class="h-4 w-4"></i>
                </span>
                <span class="text-sm font-bold text-white">GPS Navigation</span>
              </div>
            </div>

            <!-- CTA Buttons -->
            <div class="flex flex-col gap-3 sm:flex-row">
              <a href="#search" class="inline-flex min-w-[200px] items-center justify-center gap-2 rounded-full bg-white px-7 py-4 text-sm font-black text-emerald-950 shadow-xl transition hover:bg-emerald-50 active:scale-95">
                <i data-lucide="search" class="h-4 w-4"></i>
                Find Boarding Houses
              </a>
              <a href="#map" class="inline-flex min-w-[180px] items-center justify-center gap-2 rounded-full border-2 border-white/60 bg-transparent px-7 py-4 text-sm font-black text-white shadow-lg transition hover:bg-white/10 hover:border-white active:scale-95">
                <i data-lucide="map-pinned" class="h-4 w-4"></i>
                Explore the Map
              </a>
            </div>
          </div>

          <!-- Right: Floating boarding house card — inspired by BHRental style -->
          <div class="relative flex justify-center lg:justify-end">
            <!-- Main tilted/floating card -->
            <div class="relative w-full max-w-sm">
              <!-- Card container -->
              <div class="overflow-hidden rounded-[28px] bg-white shadow-[0_40px_100px_rgba(2,48,32,0.35)] ring-1 ring-white/20 transition hover:-translate-y-1 hover:shadow-[0_60px_120px_rgba(2,48,32,0.40)] duration-300">
                <!-- Room image -->
                <div class="relative h-56">
                  <img
                    src="https://images.unsplash.com/photo-1555854877-bab0e564b8d5?auto=format&fit=crop&w=800&q=80"
                    alt="Boarding House Interior"
                    class="h-full w-full object-cover"
                  >
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 to-transparent"></div>
                  <span class="absolute left-4 top-4 rounded-full bg-emerald-500 px-3 py-1 text-[11px] font-black uppercase tracking-wider text-white shadow-md">✓ Verified</span>
                </div>
                <!-- Card body -->
                <div class="p-5">
                  <div class="flex items-start justify-between">
                    <div>
                      <h3 class="font-display text-base font-extrabold text-slate-900"> Verified Boarding Houses</h3>
                      <p class="mt-0.5 text-xs text-slate-500">Near Institutions in Bongabong</p>
                    </div>
                    <div class="flex h-8 w-8 shrink-0 items-center justify-center overflow-hidden rounded-full border border-emerald-100 bg-white shadow-sm">
                      <img src="https://bongabong.gov.ph/logo.png" onerror="this.src='/images/bongabong-seal.png'" alt="Bongabong Official Seal" class="h-full w-full object-contain p-0.5">
                    </div>
                  </div>
                </div>
              </div>

              <!-- Floating info bubble — Verified Landlords -->
              <div class="absolute -left-8 -bottom-5 flex items-center gap-2.5 rounded-2xl bg-white px-4 py-3 shadow-2xl border border-slate-100 z-10">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-emerald-100">
                  <i data-lucide="user-check" class="h-4 w-4 text-emerald-700"></i>
                </span>
                <div>
                  <p class="text-[10px] font-black uppercase tracking-wider text-slate-400">Trusted</p>
                  <p class="text-sm font-extrabold text-slate-900">Verified Landlords</p>
                </div>
              </div>

              <!-- Floating info bubble — Instant Booking -->
              <div class="absolute -right-6 top-8 flex items-center gap-2.5 rounded-2xl bg-emerald-950 px-4 py-3 shadow-2xl border border-emerald-900 z-10">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-emerald-800">
                  <i data-lucide="zap" class="h-4 w-4 text-emerald-300"></i>
                </span>
                <div>
                  <p class="text-[10px] font-black uppercase tracking-wider text-emerald-400">Fast</p>
                  <p class="text-sm font-extrabold text-white">Instant Inquiry</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Wave divider -->
      <div class="absolute bottom-0 left-0 right-0 z-10">
        <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" class="w-full h-[60px]">
          <path d="M0 60 L0 30 Q360 0 720 30 Q1080 60 1440 30 L1440 60 Z" fill="#f8fafc"/>
        </svg>
      </div>
    </section>

    <section id="search" class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
      <div class="glass-card rounded-[28px] p-5 sm:p-6 lg:p-7">
        <div class="flex flex-col gap-2 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.24em] text-slate-500">Quick Search</p>
            <h2 class="font-display mt-2 text-2xl font-bold text-slate-950 sm:text-3xl">Find a verified boarding house fast</h2>
          </div>
          <button type="button" id="useLocationButton" class="inline-flex items-center justify-center gap-2 rounded-full border border-emerald-950/10 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-[var(--dormmap-primary)] hover:text-[var(--dormmap-primary)]">
            <i data-lucide="locate-fixed" class="h-4 w-4"></i>
            Use My Current Location
          </button>
        </div>

<p id="quickSearchStatus" role="status" aria-live="polite" class="mt-4 rounded-xl bg-emerald-50 px-4 py-3 text-sm text-emerald-900">Loading live listings…</p>
        <div class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-6">
          <label class="xl:col-span-2">
            <span class="mb-2 block text-sm font-semibold text-slate-700">Search Boarding House or School</span>
            <input type="text" id="quickSearchQuery" placeholder="Boarding house, school name, owner, or street..." class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3.5 text-sm outline-none transition focus:border-[var(--dormmap-primary)] focus:ring-4 focus:ring-emerald-950/10">
          </label>
          <label>
            <span class="mb-2 block text-sm font-semibold text-slate-700">Barangay (Bongabong)</span>
            <select id="quickBarangaySelect" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3.5 text-sm outline-none transition focus:border-[var(--dormmap-primary)] focus:ring-4 focus:ring-emerald-950/10">
              <option value="">Select Barangay</option>
              <option>Anilao</option>
              <option>Aplaya</option>
              <option>Bagong Bayan I</option>
              <option>Bagong Bayan II</option>
              <option>Batangan</option>
              <option>Bukal</option>
              <option>Camantigue</option>
              <option>Carmundo</option>
              <option>Cawayan</option>
              <option>Dayhagan</option>
              <option>Formon</option>
              <option>Hagan</option>
              <option>Hagupit</option>
              <option>Ipil</option>
              <option>Kaligtasan</option>
              <option>Labasan</option>
              <option>Labonan</option>
              <option>Libertad</option>
              <option>Lisap</option>
              <option>Luna</option>
              <option>Malitbog</option>
              <option>Mapang</option>
              <option>Masaguisi</option>
              <option>Mina de Oro</option>
              <option>Morente</option>
              <option>Ogbot</option>
              <option>Orconuma</option>
              <option>Poblacion</option>
              <option>Pulosahi</option>
              <option>Sagana</option>
              <option>San Isidro</option>
              <option>San Jose</option>
              <option>San Juan</option>
              <option>Sta. Cruz</option>
              <option>Sigange</option>
              <option>Tawas</option>
              <option>Zone I</option>
              <option>Zone II</option>
              <option>Zone III</option>
              <option>Zone IV</option>
            </select>
          </label>
          <label>
            <span class="mb-2 block text-sm font-semibold text-slate-700">Select School / Institution</span>
            <select id="quickInstitutionSelect" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3.5 text-sm outline-none transition focus:border-[var(--dormmap-primary)] focus:ring-4 focus:ring-emerald-950/10">
              <option value="">Select School</option>
              <option value="Mindoro State University">Mindoro State University (MinSU)</option>
              <option value="Bongabong National High School">Bongabong National High School</option>
              <option value="Eastern Mindoro College">Eastern Mindoro College (EMC)</option>
              <option value="TESDA Training Center">TESDA Training Center</option>
              <option value="St. Joseph Academy">St. Joseph Academy</option>
              <option value="Formon National High School">Formon National High School</option>
              <option value="Cawayan National High School">Cawayan National High School</option>
              <option value="Labasan National High School">Labasan National High School</option>
              <option value="Masaguisi National High School">Masaguisi National High School</option>
              <option value="Kaligtasan National High School">Kaligtasan National High School</option>
              <option value="Dayhagan National High School">Dayhagan National High School</option>
            </select>
          </label>
          <label>
            <span class="mb-2 block text-sm font-semibold text-slate-700">Price Range</span>
            <select id="quickPriceSelect" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3.5 text-sm outline-none transition focus:border-[var(--dormmap-primary)] focus:ring-4 focus:ring-emerald-950/10">
              <option value="">Any price</option>
              <option value="under_1000">Below ₱1,000</option>
              <option value="1000_2000">₱1,000 - ₱2,000</option>
              <option value="2000_3000">₱2,000 - ₱3,000</option>
              <option value="3000_4000">₱3,000 - ₱4,000</option>
              <option value="4000_5000">₱4,000 - ₱5,000</option>
              <option value="above_5000">₱5,000 and up</option>
            </select>
          </label>
          <label>
            <span class="mb-2 block text-sm font-semibold text-slate-700">Boarding Type</span>
            <select id="quickTypeSelect" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3.5 text-sm outline-none transition focus:border-[var(--dormmap-primary)] focus:ring-4 focus:ring-emerald-950/10">
              <option value="">Any type</option>
              <option value="Solo Room">Solo Room</option>
              <option value="Shared Room">Shared Room</option>
              <option value="Dormitory">Dormitory</option>
              <option value="Apartment">Apartment</option>
            </select>
          </label>
        </div>

        <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-sm text-slate-500">School searches show boarding houses within 3 km. Price-only searches cover all of Bongabong.</p>
          <button type="button" id="quickSearchBtn" onclick="performQuickSearch()" class="inline-flex items-center justify-center gap-2 rounded-full px-6 py-3.5 text-sm font-semibold text-white shadow-lg transition hover:opacity-95 cursor-pointer active:scale-95" style="background: var(--dormmap-primary);">
            <i data-lucide="search" class="h-4 w-4"></i>
            Search Now
          </button>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-[24px] p-6 text-white shadow-[0_18px_50px_rgba(2,48,32,0.22)]" style="background: linear-gradient(135deg, #023020 0%, #084d34 100%);">
          <p class="text-sm font-semibold text-emerald-100/80">Registered Boarding Houses</p>
          <div class="mt-3 flex items-end gap-2">
            <span class="text-4xl font-extrabold text-white" data-live-stat="registeredHouses">—</span>
            <span class="mb-1 text-sm font-semibold text-emerald-100/90" data-live-stat="newHousesThisMonth">— this month</span>
          </div>
        </div>
        <div class="rounded-[24px] p-6 text-white shadow-[0_18px_50px_rgba(2,48,32,0.22)]" style="background: linear-gradient(135deg, #023020 0%, #084d34 100%);">
          <p class="text-sm font-semibold text-emerald-100/80">Active Tenants</p>
          <div class="mt-3 flex items-end gap-2">
            <span class="text-4xl font-extrabold text-white" data-live-stat="activeTenants">—</span>
            <span class="mb-1 text-sm font-semibold text-emerald-100/90">Current active residents</span>
          </div>
        </div>
        <div class="rounded-[24px] p-6 text-white shadow-[0_18px_50px_rgba(2,48,32,0.22)]" style="background: linear-gradient(135deg, #023020 0%, #084d34 100%);">
          <p class="text-sm font-semibold text-emerald-100/80">Educational Institutions</p>
          <div class="mt-3 flex items-end gap-2">
            <span class="text-4xl font-extrabold text-white" data-live-stat="institutions">—</span>
            <span class="mb-1 text-sm font-semibold text-emerald-100/90">Schools covered</span>
          </div>
        </div>
        <div class="rounded-[24px] p-6 text-white shadow-[0_18px_50px_rgba(2,48,32,0.22)]" style="background: linear-gradient(135deg, #023020 0%, #084d34 100%);">
          <p class="text-sm font-semibold text-emerald-100/80">Barangays Covered</p>
          <div class="mt-3 flex items-end gap-2">
            <span class="text-4xl font-extrabold text-white" data-live-stat="barangays">—</span>
            <span class="mb-1 text-sm font-semibold text-emerald-100/90">Approved barangay accounts</span>
          </div>
        </div>
      </div>
    </section>

    <section id="map" class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.24em] text-slate-500">Interactive OpenStreetMap Preview</p>
          <h2 class="font-display mt-2 text-2xl font-bold text-slate-950 sm:text-3xl">Explore boarding houses near you</h2>
        </div>
        <div class="hidden sm:flex items-center gap-2">
          <button type="button" id="resetMapFilterBtn" onclick="resetMapAndFilters()" class="rounded-full border border-slate-200 bg-white px-4 py-2.5 text-xs font-bold text-slate-700 shadow-xs transition hover:bg-slate-50 hover:border-emerald-300 inline-flex items-center gap-1.5 active:scale-95 cursor-pointer">
            <svg class="w-3.5 h-3.5 text-emerald-800 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></svg>
            Refresh Map
          </button>
          <a href="https://www.openstreetmap.org/#map=15/12.7192/121.4719" target="_blank" class="rounded-full border border-emerald-950/10 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-[var(--dormmap-primary)] hover:text-[var(--dormmap-primary)] inline-flex gap-1.5 items-center">
            <svg class="w-4 h-4 text-emerald-800 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="1 6 1 22 8 18 15 22 22 18 22 2 15 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="15" y1="6" x2="15" y2="22"/></svg> Open Full Map ↗
          </a>
        </div>
      </div>
      <div class="mt-5 grid gap-6 xl:grid-cols-[1.6fr_1fr]">
        <div class="overflow-hidden rounded-[28px] border border-slate-200 bg-white shadow-[0_24px_60px_rgba(15,23,42,0.08)]">
          <div id="landingMap" class="map-frame w-full"></div>
        </div>
        <div class="space-y-4 rounded-[28px] border border-slate-200 bg-white p-6 shadow-[0_24px_60px_rgba(15,23,42,0.08)]">
          <div class="flex items-center justify-between gap-4">
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.24em] text-slate-500">Live Listings</p>
              <h3 class="mt-2 text-lg font-semibold text-slate-900">Boarding houses near you</h3>
            </div>
            <span id="listingCount" class="rounded-full bg-emerald-100 px-4 py-2 text-sm font-semibold text-emerald-900">0 listings</span>
          </div>
          <div id="boardingHouseList" class="space-y-4" aria-live="polite">
            <p class="rounded-2xl bg-slate-50 p-4 text-sm text-slate-600">Loading verified boarding house locations from the DormMap network...</p>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.24em] text-slate-500">Featured Boarding Houses</p>
          <h2 class="font-display mt-2 text-2xl font-bold text-slate-950 sm:text-3xl">Top verified listings</h2>
        </div>
        <a href="#" class="hidden text-sm font-semibold text-[var(--dormmap-primary)] sm:inline-flex">View all</a>
      </div>

      <div id="topListingsGrid" class="mt-5 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        <article class="overflow-hidden rounded-[28px] bg-white shadow-[0_18px_40px_rgba(15,23,42,0.08)] flex flex-col justify-between">
          <div>
            <div class="h-56 w-full bg-slate-200 animate-pulse"></div>
