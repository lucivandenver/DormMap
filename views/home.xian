            <div class="h-11 w-full bg-slate-200 rounded-full animate-pulse"></div>
          </div>
        </article>
        <article class="overflow-hidden rounded-[28px] bg-white shadow-[0_18px_40px_rgba(15,23,42,0.08)] flex flex-col justify-between">
          <div>
            <div class="h-56 w-full bg-slate-200 animate-pulse"></div>
            <div class="p-5 space-y-3">
              <div class="h-6 w-3/4 bg-slate-200 rounded animate-pulse"></div>
              <div class="h-4 w-1/2 bg-slate-100 rounded animate-pulse"></div>
              <div class="h-6 w-2/3 bg-slate-100 rounded-full animate-pulse mt-4"></div>
            </div>
          </div>
          <div class="p-5 pt-0">
            <div class="h-11 w-full bg-slate-200 rounded-full animate-pulse"></div>
          </div>
        </article>
        <article class="overflow-hidden rounded-[28px] bg-white shadow-[0_18px_40px_rgba(15,23,42,0.08)] flex flex-col justify-between">
          <div>
            <div class="h-56 w-full bg-slate-200 animate-pulse"></div>
            <div class="p-5 space-y-3">
              <div class="h-6 w-3/4 bg-slate-200 rounded animate-pulse"></div>
              <div class="h-4 w-1/2 bg-slate-100 rounded animate-pulse"></div>
              <div class="h-6 w-2/3 bg-slate-100 rounded-full animate-pulse mt-4"></div>
            </div>
          </div>
