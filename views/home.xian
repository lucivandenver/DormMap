      </div>
    </footer>
  </main>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Property Detail Modal -->
  <div id="propertyDetailModal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-slate-950/75 p-3 sm:p-4 backdrop-blur-md overflow-y-auto">
    <div class="relative w-full max-w-2xl bg-white rounded-3xl shadow-2xl overflow-hidden my-6 animate-in fade-in zoom-in duration-200">
      
      <!-- Prominent Image Carousel (Wireframe Image 4 Style) -->
      <div class="relative h-72 sm:h-80 md:h-96 bg-slate-950 overflow-hidden select-none group">
        <!-- Carousel Track -->
        <div id="detailCarouselTrack" class="flex h-full w-full transition-transform duration-300 ease-out">
          <!-- Dynamic slides populated by initDetailCarousel -->
        </div>

        <!-- Carousel Left Arrow -->
        <button type="button" id="carouselPrevBtn" onclick="moveDetailCarousel(-1)" class="absolute left-3 top-1/2 -translate-y-1/2 flex items-center justify-center w-9 h-9 rounded-full bg-black/60 hover:bg-black/90 text-white backdrop-blur-md shadow-lg transition z-20 cursor-pointer focus:outline-none" title="Previous Photo">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        </button>

        <!-- Carousel Right Arrow -->
        <button type="button" id="carouselNextBtn" onclick="moveDetailCarousel(1)" class="absolute right-3 top-1/2 -translate-y-1/2 flex items-center justify-center w-9 h-9 rounded-full bg-black/60 hover:bg-black/90 text-white backdrop-blur-md shadow-lg transition z-20 cursor-pointer focus:outline-none" title="Next Photo">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </button>

        <!-- Carousel Dots -->
        <div id="detailCarouselDots" class="absolute bottom-3 left-1/2 -translate-x-1/2 flex items-center gap-1.5 z-20 bg-black/40 backdrop-blur-sm px-3 py-1 rounded-full">
          <!-- Rendered dynamically -->
        </div>

        <!-- Carousel Counter Badge (e.g. 1 / 3) -->
        <div id="detailCarouselCounter" class="absolute top-4 left-4 z-20 px-2.5 py-0.5 rounded-full bg-black/60 text-white text-[11px] font-semibold backdrop-blur-md">1 / 1</div>

        <!-- Close Button -->
        <button type="button" onclick="closePropertyDetailModal()" class="absolute top-4 right-4 z-20 flex items-center justify-center w-8 h-8 rounded-full bg-black/60 hover:bg-black/90 text-white font-bold text-sm backdrop-blur-md shadow transition cursor-pointer" title="Close">✕</button>

        <!-- Title & Location Overlay -->
        <div class="absolute inset-x-0 bottom-7 pt-16 pb-2 px-5 bg-gradient-to-t from-slate-950/95 via-slate-950/60 to-transparent z-10 pointer-events-none text-white">
          <div class="flex items-center gap-1.5 flex-wrap">
            <span id="detailBadge" class="bg-emerald-600 text-white text-[9px] font-extrabold px-2.5 py-0.5 rounded-full uppercase tracking-wider inline-block">✓ Verified</span>
            <span id="detailDistanceBadge" class="bg-slate-900/80 text-white text-[9px] font-bold px-2.5 py-0.5 rounded-full inline-flex items-center gap-1 backdrop-blur-md hidden border border-white/20">
              <span class="text-emerald-400">📍</span>
              <span id="detailDistanceText">-- km away</span>
            </span>
          </div>
          <h3 id="detailTitle" class="text-xl sm:text-2xl font-black mt-1 leading-tight text-white drop-shadow"></h3>
<div id="detailRegistrationStatus" role="status" class="rounded-xl p-3 text-sm"></div>
          <p id="detailAddress" class="text-xs text-slate-200 mt-0.5 flex items-center gap-1"></p>
        </div>
      </div>

      <!-- Compact Details Section (Small Fonts and Proportional Buttons as requested) -->
      <div class="p-4 sm:p-5 space-y-3.5 max-h-[50vh] overflow-y-auto">
        <div id="detailRoomInventory"></div>
        
        <!-- 4-Stat Compact Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 bg-slate-50 p-3 rounded-xl border border-slate-100">
          <div>
            <p class="text-[9px] font-bold text-slate-400 uppercase tracking-wider">Available Rooms</p>
            <p id="detailRooms" class="text-xs font-black text-emerald-700 mt-0.5 truncate"></p>
          </div>
          <div>
            <p class="text-[9px] font-bold text-slate-400 uppercase tracking-wider">Owner Name</p>
            <p id="detailOwner" class="text-xs font-bold text-slate-800 mt-0.5 truncate"></p>
          </div>
          <div>
            <p class="text-[9px] font-bold text-slate-400 uppercase tracking-wider">Contact</p>
            <p id="detailContact" class="text-xs font-bold text-slate-800 mt-0.5 truncate"></p>
          </div>
          <div>
            <p class="text-[9px] font-bold text-slate-400 uppercase tracking-wider">Monthly Price</p>
            <p id="detailPrice" class="text-xs font-black text-slate-900 mt-0.5 truncate"></p>
          </div>
        </div>

        <!-- Room Types -->
        <div>
          <h4 class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Room Types Offered</h4>
          <div id="detailRoomTypes" class="flex flex-wrap gap-1.5"></div>
        </div>

        <!-- Payment Methods -->
        <div>
          <h4 class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Accepted Payment Methods</h4>
          <div id="detailPayments" class="flex flex-wrap gap-1.5"></div>
        </div>

        <!-- Compact Action Buttons -->
        <div id="detailContactArea" class="pt-2.5 border-t border-slate-100 grid grid-cols-2 sm:grid-cols-4 gap-2">
          <button type="button" id="detailInquireBtn" onclick="handleInquireClick()" class="bg-slate-900 hover:bg-slate-800 text-white font-bold py-2 px-2.5 rounded-xl text-center text-xs shadow-sm transition flex items-center justify-center gap-1.5 cursor-pointer">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <span>Inquire Now</span>
          </button>
          <button type="button" id="detailDirectionsBtn" onclick="handleGiveDirectionsClick()" class="bg-slate-800 hover:bg-slate-700 text-white font-bold py-2 px-2.5 rounded-xl text-center text-xs shadow-sm transition flex items-center justify-center gap-1.5 cursor-pointer">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Get Directions</span>
          </button>
          <a id="detailCallBtn" href="#" class="bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold py-2 px-2.5 rounded-xl text-center text-xs transition flex items-center justify-center gap-1.5 truncate">
            <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span id="detailCallBtnText" class="truncate">Call</span>
          </a>
          <button type="button" onclick="closePropertyDetailModal()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold py-2 px-2.5 rounded-xl text-xs transition flex items-center justify-center cursor-pointer">
            Close
          </button>
        </div>
      </div>
    </div>
  </div>

  {{> authModal }}

  <script>
    // ── Inquiry → Auth Redirect ─────────────────────────────────────────────
    // Clicking "Inquire Now" no longer creates anonymous messages.
    // Instead it opens the Sign In / Register modal with the boarding house pre-filled.
    window.closeInquiryModal = function() {}; // kept as no-op for legacy calls
  </script>

  <script>
    window.currentSelectedHouse = null;
    window.currentDirectionRoute = null;
    window.landingMapMarkers = [];

    let detailCarouselSlides = [];
    let detailCarouselCurrentIndex = 0;

    window.initDetailCarousel = function(images) {
      detailCarouselSlides = Array.isArray(images) && images.length > 0 ? images.filter(Boolean) : [];
      detailCarouselCurrentIndex = 0;

      const track = document.getElementById('detailCarouselTrack');
      const dotsContainer = document.getElementById('detailCarouselDots');
      const prevBtn = document.getElementById('carouselPrevBtn');
      const nextBtn = document.getElementById('carouselNextBtn');
      const counter = document.getElementById('detailCarouselCounter');

      if (!track) return;

      if (detailCarouselSlides.length === 0) {
        // Fallback placeholder slide
        track.innerHTML = `
          <div class="w-full h-full flex-shrink-0 flex flex-col items-center justify-center bg-slate-900 text-slate-400 gap-2 p-4 text-center">
            <svg class="w-12 h-12 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
            <span class="text-xs font-semibold text-slate-400">No photos uploaded for this boarding house yet</span>
          </div>
        `;
        if (dotsContainer) dotsContainer.style.display = 'none';
        if (prevBtn) prevBtn.style.display = 'none';
        if (nextBtn) nextBtn.style.display = 'none';
        if (counter) counter.style.display = 'none';
        track.style.transform = 'translateX(0%)';
        return;
      }

      const categoryLabels = [
        '🌿 1. Outdoor Spaces',
        '🛋️ 2. Living Area',
        '🛏️ 3. Bedroom',
        '🍽️ 4. Dining or kitchenette',
        '🚿 5. Bathroom'
      ];

      // Build slides
      track.innerHTML = detailCarouselSlides.map((url, idx) => `
        <div class="w-full h-full flex-shrink-0 relative bg-slate-950 flex items-center justify-center overflow-hidden">
          <img src="${escapeHtml(url)}" alt="${categoryLabels[idx] || ('Photo ' + (idx + 1))}" class="w-full h-full object-cover select-none" onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\\'w-full h-full flex flex-col items-center justify-center bg-slate-900 text-slate-400 gap-2\\'><svg class=\\'w-10 h-10 text-slate-600\\' fill=\\'none\\' stroke=\\'currentColor\\' viewBox=\\'0 0 24 24\\'><rect width=\\'18\\' height=\\'18\\' x=\\'3\\' y=\\'3\\' rx=\\'2\\'/><circle cx=\\'9\\' cy=\\'9\\' r=\\'2\\'/><path d=\\'m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21\\'/></svg><span class=\\'text-xs\\'>Photo load error</span></div>';">
          ${idx < 5 ? `
            <div class="absolute top-4 left-16 z-20 px-2.5 py-0.5 rounded-full bg-slate-950/75 border border-white/20 text-white text-[10px] font-bold backdrop-blur-md shadow-sm">
              ${categoryLabels[idx]}
            </div>
          ` : ''}
        </div>
      `).join('');

      // Build dots and arrows
      if (detailCarouselSlides.length > 1) {
        if (dotsContainer) {
          dotsContainer.style.display = 'flex';
          dotsContainer.innerHTML = detailCarouselSlides.map((_, idx) => `
            <button type="button" onclick="goToDetailSlide(${idx})" class="detail-carousel-dot w-2 h-2 rounded-full transition-all cursor-pointer ${idx === 0 ? 'bg-white scale-125' : 'bg-white/40 hover:bg-white/70'}" title="Photo ${idx + 1}"></button>
          `).join('');
        }
        if (prevBtn) prevBtn.style.display = 'flex';
        if (nextBtn) nextBtn.style.display = 'flex';
        if (counter) {
          counter.style.display = 'block';
          counter.textContent = `1 / ${detailCarouselSlides.length}`;
        }
      } else {
        if (dotsContainer) dotsContainer.style.display = 'none';
        if (prevBtn) prevBtn.style.display = 'none';
        if (nextBtn) nextBtn.style.display = 'none';
        if (counter) {
          counter.style.display = 'block';
          counter.textContent = `1 / 1`;
        }
      }

      track.style.transform = 'translateX(0%)';
    };

    window.moveDetailCarousel = function(direction) {
      if (detailCarouselSlides.length <= 1) return;
      let newIndex = detailCarouselCurrentIndex + direction;
      if (newIndex < 0) newIndex = detailCarouselSlides.length - 1;
      if (newIndex >= detailCarouselSlides.length) newIndex = 0;
      goToDetailSlide(newIndex);
    };

    window.goToDetailSlide = function(index) {
      if (index < 0 || index >= detailCarouselSlides.length) return;
      detailCarouselCurrentIndex = index;
      const track = document.getElementById('detailCarouselTrack');
      if (track) {
        track.style.transform = `translateX(-${index * 100}%)`;
      }

      // Update dots
      const dots = document.querySelectorAll('.detail-carousel-dot');
      dots.forEach((dot, idx) => {
        if (idx === index) {
          dot.className = 'detail-carousel-dot w-2.5 h-2 rounded-full transition-all cursor-pointer bg-white scale-125';
        } else {
          dot.className = 'detail-carousel-dot w-2 h-2 rounded-full transition-all cursor-pointer bg-white/40 hover:bg-white/70';
        }
      });

      // Update counter
      const counter = document.getElementById('detailCarouselCounter');
      if (counter) {
        counter.textContent = `${index + 1} / ${detailCarouselSlides.length}`;
      }
    };

    window.openPropertyDetailModal = function(houseId) {
      const houses = window.allBoardingHousesCache || [];
      const house = houses.find(h => String(h.id) === String(houseId));
      if (!house) return;

      window.currentSelectedHouse = house;
      const unregistered = house.registrationStatus === 'unregistered';
      const badge = document.getElementById('detailBadge');
      badge.textContent = unregistered ? 'Unregistered' : 'Registered';
      badge.classList.toggle('bg-red-700', unregistered);
      badge.classList.toggle('bg-emerald-600', !unregistered);
      const inquire = document.getElementById('detailInquireBtn');
      inquire.disabled = unregistered;
      inquire.querySelector('span').textContent = unregistered ? 'Registration pending' : 'Inquire Now';
      inquire.classList.toggle('opacity-50', unregistered);
      const warning = document.getElementById('detailRegistrationStatus');
      warning.textContent = house.registrationStatus === 'unregistered' ? 'UNREGISTERED — Published by the barangay for public information. This is not an accredited rental listing.' : 'Registered establishment';
      warning.className = house.registrationStatus === 'unregistered' ? 'rounded-xl bg-red-50 border border-red-200 p-3 text-sm font-bold text-red-800' : 'rounded-xl bg-emerald-50 p-3 text-sm text-emerald-900';

      document.getElementById('detailTitle').textContent = house.boardingHouseName || house.fullName || 'Boarding House';
      document.getElementById('detailAddress').textContent = (house.boardingHouseAddress || house.barangay || 'Bongabong, Oriental Mindoro');
      document.getElementById('detailRooms').textContent = (house.roomsAvailable ?? 0) + ' vacant rooms';
      document.getElementById('detailOwner').textContent = house.fullName || 'Registered Owner';
      document.getElementById('detailContact').textContent = house.contactNumber || house.email || 'Not provided';
      document.getElementById('detailPrice').textContent = (() => {
        const min = Number(house.rentalPriceMin);
        const max = Number(house.rentalPriceMax);
        if (min > 0 && max > 0 && min !== max) return `₱${min.toLocaleString()} – ₱${max.toLocaleString()}/mo`;
        if (min > 0) return `₱${min.toLocaleString()}/mo`;
        if (max > 0) return `₱${max.toLocaleString()}/mo`;
        return 'Contact for price';
      })();

      // Populate carousel with all images provided by owner (primary picture, gallery, room photos)
      const rawImages = (Array.isArray(house.galleryImages) && house.galleryImages.length > 0)
        ? house.galleryImages
        : [house.boardingHousePicture, house.profilePicture].filter(Boolean);
      initDetailCarousel(rawImages);

      document.getElementById('detailRoomInventory').innerHTML = window.DormRoomDetails.render(house.roomInventory || []);
      const typesArr = Array.isArray(house.roomTypes) && house.roomTypes.length ? house.roomTypes : ['Not specified'];
      document.getElementById('detailRoomTypes').innerHTML = typesArr.map(t => `<span class="bg-emerald-50 text-emerald-800 text-[11px] font-bold px-2.5 py-1 rounded-lg border border-emerald-200/60">${escapeHtml(t)}</span>`).join('');

      const payArr = Array.isArray(house.paymentMethods) && house.paymentMethods.length ? house.paymentMethods : ['Not specified'];
      document.getElementById('detailPayments').innerHTML = payArr.map(p => `<span class="bg-slate-100 text-slate-700 text-[11px] font-bold px-2.5 py-1 rounded-lg border border-slate-200">${escapeHtml(p)}</span>`).join('');

      const callBtn = document.getElementById('detailCallBtn');
      const callText = document.getElementById('detailCallBtnText');
      if (house.contactNumber) {
        callBtn.href = `tel:${house.contactNumber}`;
        if (callText) callText.textContent = `Call ${house.contactNumber}`;
      } else if (house.email) {
        callBtn.href = `mailto:${house.email}`;
        if (callText) callText.textContent = `Email`;
      } else {
        callBtn.href = '#';
        if (callText) callText.textContent = `Contact`;
      }

      // Distance badge: reset then request user GPS
      const distBadge = document.getElementById('detailDistanceBadge');
      const distText = document.getElementById('detailDistanceText');
      if (distBadge && distText) {
        const houseLat = Number(house.latitude);
        const houseLng = Number(house.longitude);
        if (houseLat && houseLng && navigator.geolocation) {
          distBadge.classList.remove('hidden');
          distText.textContent = 'Calculating...';
          navigator.geolocation.getCurrentPosition(
            (pos) => {
              const km = _haversineKm(pos.coords.latitude, pos.coords.longitude, houseLat, houseLng);
              distText.textContent = km < 1 ? `${Math.round(km * 1000)} m away` : `${km.toFixed(1)} km away`;
            },
            () => { distBadge.classList.add('hidden'); },
            { enableHighAccuracy: true, timeout: 8000 }
          );
        } else {
          distBadge.classList.add('hidden');
        }
      }

      if (window.map) {
        window.map.closePopup();
      }

      const modal = document.getElementById('propertyDetailModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };

    // Haversine formula — returns distance in km between two lat/lng points
    function _haversineKm(lat1, lng1, lat2, lng2) {
      const R = 6371;
      const dLat = (lat2 - lat1) * Math.PI / 180;
      const dLng = (lng2 - lng1) * Math.PI / 180;
      const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                Math.sin(dLng/2) * Math.sin(dLng/2);
      return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }

    window.renderTopVerifiedListings = function(houses) {
      const container = document.getElementById('topListingsGrid');
      if (!container) return;

      const validHouses = Array.isArray(houses) ? houses : [];
      let html = '';

      for (let i = 0; i < 3; i++) {
        const house = validHouses[i];
        if (house) {
          const bhName = house.boardingHouseName || house.fullName || 'Boarding House';
          const address = house.barangay ? ('Barangay ' + house.barangay) : (house.boardingHouseAddress || 'Bongabong, Oriental Mindoro');
          const rooms = (house.roomsAvailable ?? 0) + ' available rooms';
          const pic = house.boardingHousePicture || (Array.isArray(house.galleryImages) && house.galleryImages[0]) || '';

          const priceText = (() => {
            const min = Number(house.rentalPriceMin);
            const max = Number(house.rentalPriceMax);
            if (min > 0 && max > 0 && min !== max) return `₱${min.toLocaleString()} – ₱${max.toLocaleString()}`;
            if (min > 0) return `₱${min.toLocaleString()}`;
            if (max > 0) return `₱${max.toLocaleString()}`;
            return 'Contact for price';
          })();

          let imgMarkup = '';
          if (pic) {
            imgMarkup = `
              <img src="${escapeHtml(pic)}" alt="${escapeHtml(bhName)}" class="h-56 w-full object-cover select-none" onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='flex';">
              <div class="h-56 w-full bg-slate-100 flex-col items-center justify-center text-slate-400 gap-2" style="display:none;">
                <svg class="w-10 h-10 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                <span class="text-xs font-semibold text-slate-400">Photo Unavailable</span>
              </div>
            `;
          } else {
            imgMarkup = `
              <div class="h-56 w-full bg-slate-100 flex flex-col items-center justify-center text-slate-400 gap-2">
                <svg class="w-10 h-10 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                <span class="text-xs font-semibold text-slate-400">No Photo Uploaded</span>
              </div>
            `;
          }

          const houseDistBadge = `<span class="listing-dist-badge rounded-full bg-slate-100 px-3 py-1 text-slate-500" data-lat="${house.latitude || ''}" data-lng="${house.longitude || ''}" data-dist-el="true">📍 Getting distance...</span>`;

          html += `
            <article class="overflow-hidden rounded-[28px] bg-white shadow-[0_18px_40px_rgba(15,23,42,0.08)] transition hover:-translate-y-1 flex flex-col justify-between">
              <div>
                <div class="relative bg-slate-100 overflow-hidden">
                  ${imgMarkup}
                  <span class="absolute left-4 top-4 rounded-full bg-white/95 backdrop-blur-sm px-3 py-1 text-xs font-bold text-[var(--dormmap-primary)] shadow-sm">✓ Verified</span>
                </div>
                <div class="p-5">
                  <div class="flex items-start justify-between gap-4">
                    <div class="min-w-0">
                      <h3 class="text-lg font-bold text-slate-950 truncate">${escapeHtml(bhName)}</h3>
                      <p class="mt-1 text-sm text-slate-500 truncate">${escapeHtml(address)}</p>
                    </div>
                    <div class="text-right flex-shrink-0">
                      <p class="text-xs font-semibold text-slate-500">Monthly</p>
                      <p class="text-lg font-bold text-[var(--dormmap-primary)]">${priceText}</p>
                    </div>
                  </div>
                  <div class="mt-4 flex flex-wrap gap-2 text-xs font-semibold text-slate-600">
                    <span class="rounded-full bg-slate-100 px-3 py-1">${rooms}</span>
                    ${houseDistBadge}
                  </div>
                </div>
              </div>
              <div class="p-5 pt-0">
                <button type="button" onclick="openPropertyDetailModal('${house.id}')" class="inline-flex w-full items-center justify-center rounded-full px-4 py-3 text-sm font-semibold text-white transition hover:opacity-90 cursor-pointer shadow-sm" style="background: var(--dormmap-primary);">View Details</button>
              </div>
            </article>
          `;
        } else {
          // 3rd slot placeholder (identical dimensions, classes, and structure!)
          html += `
            <article class="overflow-hidden rounded-[28px] bg-white shadow-[0_18px_40px_rgba(15,23,42,0.08)] transition hover:-translate-y-1 flex flex-col justify-between border border-dashed border-slate-200">
              <div>
                <div class="relative bg-slate-50 overflow-hidden border-b border-dashed border-slate-200">
                  <div class="h-56 w-full flex flex-col items-center justify-center text-slate-400 gap-2 p-4 text-center">
                    <div class="w-12 h-12 rounded-2xl bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-400">
                      <svg class="w-6 h-6 stroke-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                    </div>
                    <div>
                      <p class="text-xs font-bold text-slate-600">Listing Slot Available</p>
                      <p class="text-[11px] text-slate-400 mt-0.5">Municipal BPLO Verification in progress</p>
                    </div>
                  </div>
                  <span class="absolute left-4 top-4 rounded-full bg-slate-200/90 backdrop-blur-sm px-3 py-1 text-xs font-bold text-slate-600">Pending Listing</span>
                </div>
                <div class="p-5">
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <h3 class="text-lg font-bold text-slate-700">Awaiting Registration</h3>
                      <p class="mt-1 text-sm text-slate-400">Bongabong, Oriental Mindoro</p>
                    </div>
                    <div class="text-right">
                      <p class="text-xs font-semibold text-slate-400">Monthly</p>
                      <p class="text-base font-bold text-slate-500">Open Slot</p>
                    </div>
                  </div>
                  <div class="mt-4 flex flex-wrap gap-2 text-xs font-semibold text-slate-500">
                    <span class="rounded-full bg-slate-100 px-3 py-1">Accredited Only</span>
                    <span class="rounded-full bg-slate-100 px-3 py-1">Safe Housing</span>
                    <span class="rounded-full bg-slate-100 px-3 py-1">BPLO Zone</span>
                  </div>
                </div>
              </div>
              <div class="p-5 pt-0">
                <button type="button" onclick="const r = document.getElementById('dormmapAuthRoot'); if(r){ r.classList.remove('hidden'); r.classList.add('flex'); window.authShowMode?.('register'); }" class="inline-flex w-full items-center justify-center rounded-full px-4 py-3 text-sm font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 transition cursor-pointer">Register Your Boarding House</button>
              </div>
            </article>
          `;
        }
      }

      container.innerHTML = html;
      // After render, compute GPS distances for all listing cards
      setTimeout(() => window._updateListingDistanceBadges?.(), 200);
    };

    window.closePropertyDetailModal = function() {
      const modal = document.getElementById('propertyDetailModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    };

    window.handleInquireClick = function() {
      const house = window.currentSelectedHouse;
      if (!house) return;
      if (house.registrationStatus === 'unregistered') { Swal.fire('Unregistered establishment', 'This listing is provided for public awareness. Applications are disabled until registration is approved.', 'warning'); return; }

      const bhName = house.boardingHouseName || house.fullName || '';

      // Close the property detail modal first
      closePropertyDetailModal();

      // Open the auth modal in Register → Tenant mode using the global API
      if (typeof window.openDormmapAuth === 'function') {
        window.openDormmapAuth('register', 'tenant');
      } else {
        // Fallback: manually set dataset open
        const authRoot = document.getElementById('dormmapAuthRoot');
        if (authRoot) {
          authRoot.dataset.open = 'true';
          document.body.classList.add('overflow-hidden');
          const registerTab = document.querySelector('[data-auth-tab="register"]');
          const tenantRoleCard = document.querySelector('[data-auth-role="tenant"]');
          if (registerTab) registerTab.click();
          setTimeout(() => { if (tenantRoleCard) tenantRoleCard.click(); }, 50);
        }
      }

      // After a short tick, pre-fill the boarding house in the tenant section
      setTimeout(() => {
        if (bhName) {
          const bhSelect = document.querySelector('select[name="selectedBoardingHouse"]');
          const bhSearch = document.querySelector('input[name="boardingHouseSearch"]');

          if (bhSearch) bhSearch.value = bhName;

          if (bhSelect) {
            // Add/select this BH without clobbering existing options loaded from API
            const existing = Array.from(bhSelect.options).find(o => o.value === bhName);
            if (existing) {
              existing.selected = true;
            } else {
              const opt = document.createElement('option');
              opt.value = bhName;
              opt.textContent = bhName;
              opt.selected = true;
              bhSelect.appendChild(opt);
            }
            bhSelect.disabled = false;
          }

          // Update the hint text so the user sees which BH is pre-selected
          const hint = document.querySelector('[data-tenant-hint]');
          if (hint) hint.textContent = `🏠 Pre-selected: "${bhName}" — You can change this anytime.`;
        }
      }, 150);
    };

    window.closeInquiryModal = function() {}; // no-op — inquiry modal removed

    // Compute & display GPS distance on top listing cards after render
    window._updateListingDistanceBadges = function() {
      if (!navigator.geolocation) return;
      navigator.geolocation.getCurrentPosition((pos) => {
        const userLat = pos.coords.latitude;
        const userLng = pos.coords.longitude;
        document.querySelectorAll('[data-dist-el="true"]').forEach((badge) => {
          const lat = parseFloat(badge.dataset.lat);
          const lng = parseFloat(badge.dataset.lng);
          if (!lat || !lng) {
            badge.textContent = '📍 Bongabong';
            return;
          }
          const km = _haversineKm(userLat, userLng, lat, lng);
          badge.textContent = km < 1 ? `📍 ${Math.round(km * 1000)} m away` : `📍 ${km.toFixed(1)} km away`;
          badge.classList.remove('text-slate-500');
          badge.classList.add('text-emerald-700', 'bg-emerald-50', 'border', 'border-emerald-100');
        });
      }, () => {
        // Fallback: show barangay label from data
        document.querySelectorAll('[data-dist-el="true"]').forEach((badge) => {
          badge.textContent = '📍 Bongabong';
        });
      }, { enableHighAccuracy: false, timeout: 8000 });
    };

    window.handleGiveDirectionsClick = function() {
      const house = window.currentSelectedHouse;
      if (!house) return;

      if (!DormMapSearch.hasCoordinates(house)) { Swal.fire('Location unavailable', 'This owner has not provided a map pin yet.', 'info'); return; }
      const houseLat = Number(house.latitude);
      const houseLng = Number(house.longitude);

      if (!navigator.geolocation) {
        Swal.fire('GPS Error', 'Geolocation is not supported by your browser.', 'error');
        return;
      }

      closePropertyDetailModal();
      document.getElementById('landingMap')?.scrollIntoView({ behavior: 'smooth', block: 'center' });

      navigator.geolocation.getCurrentPosition(async (pos) => {
        const userLat = pos.coords.latitude;
        const userLng = pos.coords.longitude;

        if (window.currentDirectionRoute) {
          window.map.removeLayer(window.currentDirectionRoute);
        }
        if (window.userLocationMarker) {
          window.map.removeLayer(window.userLocationMarker);
        }

        // Add user location marker
        window.userLocationMarker = L.marker([userLat, userLng], {
          icon: L.divIcon({
            className: 'user-gps-pin',
            html: `<div class="flex items-center justify-center h-8 w-8 rounded-full bg-emerald-600 text-white shadow-lg border-2 border-white font-bold"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 2v3m0 14v3M2 12h3m14 0h3"/></svg></div>`,
            iconSize: [32, 32],
            iconAnchor: [16, 16]
          })
        }).addTo(window.map).bindPopup("<b>Your Current Location</b>").openPopup();

        // Fetch turn-by-turn road route from OSRM
        try {
          const osrmUrl = `https://router.project-osrm.org/route/v1/driving/${userLng},${userLat};${houseLng},${houseLat}?overview=full&geometries=geojson`;
          const routeRes = await fetch(osrmUrl);
          const routeData = await routeRes.json();

          let routeCoords = [[userLat, userLng], [houseLat, houseLng]];
          if (routeData.code === 'Ok' && routeData.routes && routeData.routes[0]) {
            routeCoords = routeData.routes[0].geometry.coordinates.map(coord => [coord[1], coord[0]]);
          }

          // Solid green Google Maps style navigation line
          window.currentDirectionRoute = L.polyline(routeCoords, {
            color: '#047857',
            weight: 6,
            opacity: 0.95,
            lineCap: 'round',
            lineJoin: 'round'
          }).addTo(window.map);

          window.map.fitBounds(window.currentDirectionRoute.getBounds(), { padding: [60, 60] });

          Swal.fire({
            icon: 'success',
            title: 'Directions Active',
            text: `Solid green road route calculated from your GPS location to ${house.boardingHouseName || 'selected boarding house'}!`,
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 4000
          });
        } catch (err) {
          // Fallback solid green polyline
          window.currentDirectionRoute = L.polyline([[userLat, userLng], [houseLat, houseLng]], {
            color: '#047857',
            weight: 6,
            opacity: 0.95
          }).addTo(window.map);
          const bounds = L.latLngBounds([[userLat, userLng], [houseLat, houseLng]]);
          window.map.fitBounds(bounds, { padding: [60, 60] });
        }
      }, (err) => {
        Swal.fire('Location Access', 'Please allow GPS location access to get directions to this boarding house.', 'warning');
      });
    };

    // Shared Get Directions function — called directly from Leaflet popup buttons
    window._getDirectionsToCoords = async function(destLat, destLng, label) {
      if (!navigator.geolocation) {
        Swal.fire('GPS Error', 'Geolocation is not supported by your browser.', 'error');
        return;
      }

      document.getElementById('landingMap')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      if (window.map) window.map.closePopup();

      navigator.geolocation.getCurrentPosition(async (pos) => {
        const userLat = pos.coords.latitude;
        const userLng = pos.coords.longitude;

        if (window.currentDirectionRoute) window.map.removeLayer(window.currentDirectionRoute);
        if (window.userLocationMarker) window.map.removeLayer(window.userLocationMarker);

        window.userLocationMarker = L.circleMarker([userLat, userLng], {
          radius: 10, color: '#047857', fillColor: '#10b981', fillOpacity: 0.9, weight: 3
        }).addTo(window.map).bindPopup('<strong class="text-sm">📍 Your Current Location</strong>').openPopup();

        try {
          const osrmUrl = `https://router.project-osrm.org/route/v1/driving/${userLng},${userLat};${destLng},${destLat}?overview=full&geometries=geojson`;
          const routeRes = await fetch(osrmUrl);
          const routeData = await routeRes.json();

          let routeCoords = [[userLat, userLng], [destLat, destLng]];
          if (routeData.code === 'Ok' && routeData.routes?.[0]) {
            routeCoords = routeData.routes[0].geometry.coordinates.map(c => [c[1], c[0]]);
          }

          window.currentDirectionRoute = L.polyline(routeCoords, {
            color: '#047857', weight: 6, opacity: 0.95, lineCap: 'round', lineJoin: 'round'
          }).addTo(window.map);
          window.map.fitBounds(window.currentDirectionRoute.getBounds(), { padding: [60, 60] });

          Swal.fire({
            icon: 'success', title: 'Directions Active',
            text: `Route calculated to ${label || 'destination'} from your GPS location!`,
            toast: true, position: 'top-end', showConfirmButton: false, timer: 3500
          });
        } catch {
          window.currentDirectionRoute = L.polyline([[userLat, userLng], [destLat, destLng]], {
            color: '#047857', weight: 6, opacity: 0.95
          }).addTo(window.map);
          window.map.fitBounds(L.latLngBounds([[userLat, userLng], [destLat, destLng]]), { padding: [60, 60] });
        }
      }, () => {
        Swal.fire('Location Access', 'Please allow GPS location to get directions.', 'warning');
      }, { enableHighAccuracy: true, timeout: 10000 });
    };

    // Global event listener for View Details button inside map popups
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.view-detail-btn');
      if (btn) {
        e.preventDefault();
        e.stopPropagation();
        const id = btn.getAttribute('data-detail-id');
        if (id) {
          window.openPropertyDetailModal(id);
        }
      }
    });

    const header = document.getElementById('siteHeader');
    const mobileMenuButton = document.getElementById('mobileMenuButton');
    const mobileMenu = document.getElementById('mobileMenu');
    const useLocationButton = document.getElementById('useLocationButton');

    const applyHeaderState = () => {
      if (window.scrollY > 12) {
        header.classList.add('nav-scrolled');
      } else {
        header.classList.remove('nav-scrolled');
      }
    };

    window.addEventListener('scroll', applyHeaderState);
    applyHeaderState();

    mobileMenuButton?.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    const map = L.map('landingMap', { scrollWheelZoom: false }).setView([12.7192, 121.4719], 14);
    window.map = map;

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; OpenStreetMap contributors',
    }).addTo(map);

    const boardingHouseList = document.getElementById('boardingHouseList');
    const listingCount = document.getElementById('listingCount');
    const currentLocationMarkers = [];
    window.institutionMarker = null;
    window.userGpsMarker = null;

    // Dictionary of acronyms, short names, and aliases in Bongabong
    const BONGABONG_ALIASES = {
      'minsu': 'Mindoro State University',
      'msu': 'Mindoro State University',
      'mindoro state': 'Mindoro State University',
      'bnhs': 'Bongabong National High School',
      'bongabong high': 'Bongabong National High School',
      'emc': 'Eastern Mindoro College',
      'eastern mindoro': 'Eastern Mindoro College',
      'tesda': 'TESDA Training Center',
      'sja': 'St. Joseph Academy',
      'st joseph': 'St. Joseph Academy',
      'fnhs': 'Formon National High School',
      'cnhs': 'Cawayan National High School',
      'lnhs': 'Labasan National High School',
      'mnhs': 'Masaguisi National High School',
      'knhs': 'Kaligtasan National High School',
      'dnhs': 'Dayhagan National High School',
      'pob': 'Poblacion',
      'poblacion': 'Poblacion',
      'town center': 'Poblacion',
      'zone 1': 'Zone I',
      'zone 2': 'Zone II',
      'zone 3': 'Zone III',
      'zone 4': 'Zone IV'
    };

    const schoolLocations = {};
    let activeCriteria = null;
    let activePlace = null;
    let searchRadiusLayer = null;
    let searchVersion = 0;
    let searchScope = '';
    let searchWarning = '';
    const municipalityBounds = [[12.48, 121.05], [12.91, 121.58]];
    const searchStatus = document.getElementById('quickSearchStatus');

    const formatPrice = (minVal, maxVal) => {
      const min = Number(minVal);
      const max = Number(maxVal);
      if (min > 0 && max > 0 && min !== max) return `₱${min.toLocaleString()} – ₱${max.toLocaleString()}/mo`;
      if (min > 0) return `₱${min.toLocaleString()}/mo`;
      if (max > 0) return `₱${max.toLocaleString()}/mo`;
      return 'Contact for price';
    };

    const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (character) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[character]));

    const createHouseCard = (house) => {
      const roomTypes = Array.isArray(house.roomTypes) && house.roomTypes.length
        ? house.roomTypes.join(', ')
        : 'Not specified';
      const paymentMethods = Array.isArray(house.paymentMethods) && house.paymentMethods.length
        ? house.paymentMethods.join(', ')
        : 'Not specified';

      const name = escapeHtml(house.boardingHouseName || house.fullName || 'Boarding House');
      const address = escapeHtml(house.boardingHouseAddress || house.barangay || 'Address not available');
      const contact = escapeHtml(house.contactNumber || house.email || 'Not listed');
      const minP = Number(house.rentalPriceMin);
      const maxP = Number(house.rentalPriceMax);
      const estPrice = minP || maxP || null;

      return `
        <article class="rounded-[22px] border border-slate-200 bg-slate-50 p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-900/20 hover:shadow-md">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <h4 class="text-base font-semibold text-slate-950">${name}</h4><p class="mt-2 text-xs font-bold ${house.registrationStatus === 'unregistered' ? 'text-red-700' : 'text-emerald-700'}">${house.registrationStatus === 'unregistered' ? 'Unregistered — barangay public notice' : 'Registered'}</p>
              <p class="mt-1 text-sm text-slate-600">${address}</p>
            </div>
            <span class="rounded-full bg-emerald-100 px-3 py-2 text-sm font-semibold text-emerald-900">${house.roomsAvailable ?? 'N/A'} available room(s)</span>
          </div>
          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            <div>
              <p class="text-xs uppercase tracking-[0.24em] text-slate-500">Owner</p>
              <p class="mt-1 text-sm text-slate-700">${escapeHtml(house.fullName || 'Owner not set')}</p>
            </div>
            <div>
              <p class="text-xs uppercase tracking-[0.24em] text-slate-500">Contact</p>
              <p class="mt-1 text-sm text-slate-700">${contact}</p>
            </div>
          </div>
          <div class="mt-4 grid gap-2 sm:grid-cols-2">
            <span class="rounded-full bg-white px-3 py-2 text-xs font-semibold text-slate-700">${escapeHtml(roomTypes)}</span>
            <span class="rounded-full bg-white px-3 py-2 text-xs font-semibold text-slate-700">${escapeHtml(paymentMethods)}</span>
          </div>
          ${window.DormRoomDetails.render(house.roomInventory || [])}
          <div class="mt-4 flex items-center justify-between gap-3">
            <p class="text-sm font-semibold text-slate-900">${formatPrice(minP, maxP)}</p>
            <button type="button" class="focus-listing rounded-full border border-emerald-950/15 px-4 py-2 text-sm font-semibold text-emerald-950 transition hover:bg-emerald-950 hover:text-white" data-lat="${house.latitude ?? ''}" data-lng="${house.longitude ?? ''}" ${DormMapSearch.hasCoordinates(house) ? '' : 'disabled title="Location not provided"'}>Show on map</button>
            <button type="button" onclick="window.openPropertyDetailModal('${house.id}')" class="rounded-full bg-emerald-950 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-800">View Details</button>
          </div>
        </article>
      `;
    };

    const setListingCount = (count) => {
      if (!listingCount) return;
      listingCount.textContent = `${count} listing${count === 1 ? '' : 's'}`;
    };

    const clearLandingMapMarkers = () => {
      window.landingMapMarkers.forEach((m) => map.removeLayer(m));
      window.landingMapMarkers = [];
    };

    const renderDefaultListingsPlaceholder = () => {
      boardingHouseList.innerHTML = `
        <div class="rounded-2xl bg-slate-50/90 p-6 text-center border border-slate-200">
          <div class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-100 text-[#007a64] mb-3">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h4 class="text-sm font-bold text-slate-900">Find your next boarding house</h4>
          <p class="text-xs text-slate-500 mt-1">Choose a barangay or school to explore verified listings, or select a boarding house pin.</p>
        </div>
      `;
      setListingCount(0);
    };

    const renderSingleHouseCard = (house) => {
      boardingHouseList.innerHTML = createHouseCard(house);
      setListingCount(1);
      boardingHouseList.querySelectorAll('.focus-listing').forEach((button) => {
        button.addEventListener('click', () => {
          const latitude = Number(button.dataset.lat);
          const longitude = Number(button.dataset.lng);
          if (Number.isFinite(latitude) && Number.isFinite(longitude)) {
            map.setView([latitude, longitude], 17);
            document.getElementById('landingMap').scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        });
      });
    };

    const renderBoardingHouseMarkers = (houses, populateList = false, fitMap = false) => {
      clearLandingMapMarkers();
      if (populateList) boardingHouseList.innerHTML = '';
      if (populateList) setListingCount(houses.length);

      if (populateList && houses.length === 0) {
        boardingHouseList.innerHTML = '<p class="text-sm text-slate-600 p-4 bg-slate-50 rounded-2xl border border-slate-200">No boarding houses match your search criteria. Try adjusting your filters.</p>';
        return;
      }

      const bounds = L.latLngBounds();

      houses.forEach((house, idx) => {
        const latitude = Number(house.latitude);
        const longitude = Number(house.longitude);
        const name = escapeHtml(house.boardingHouseName || house.fullName || 'Boarding House');
        const address = escapeHtml(house.boardingHouseAddress || house.barangay || 'Address not available');
        const targetId = house.id || idx;

        if (DormMapSearch.hasCoordinates(house)) {
          const customPin = L.divIcon({
            className: 'custom-bh-pin',
            html: `<div class="${house.registrationStatus === 'unregistered' ? 'bg-red-700' : 'bg-emerald-950'} text-white p-2 rounded-2xl shadow-xl border-2 border-white flex items-center justify-center hover:scale-110 transition cursor-pointer" style="width:36px;height:36px;">
                     <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                   </div>`,
            iconSize: [36, 36],
            iconAnchor: [18, 36],
            popupAnchor: [0, -32]
          });

          const marker = L.marker([latitude, longitude], { icon: customPin }).addTo(map).bindPopup(`
            <div class="p-2 max-w-[260px]">
              <strong class="text-sm font-extrabold text-slate-950 block leading-tight mb-1">${name}</strong>
              <p class="text-xs text-slate-600 mb-2">📍 ${address}</p>
              <div class="flex flex-col gap-1.5 border-t border-slate-100 pt-2">
                <div class="flex items-center justify-between gap-2">
                  <span class="text-xs font-black text-emerald-800">${house.roomsAvailable ?? 0} rooms</span>
                  <button type="button" onclick="window.openPropertyDetailModal('${targetId}')" class="bg-emerald-950 hover:bg-emerald-800 text-white text-xs font-bold px-3 py-1.5 rounded-xl transition shadow-xs cursor-pointer shrink-0">
                    View Details
                  </button>
                </div>
                <button type="button"
                  data-direction-name="${name}" onclick="window._getDirectionsToCoords(${latitude}, ${longitude}, this.dataset.directionName)"
                  class="w-full bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold px-3 py-1.5 rounded-xl transition cursor-pointer flex items-center justify-center gap-1.5">
                  Get Directions
                </button>
              </div>
            </div>
          `);

          // When user clicks pin, populate live listings side panel with this boarding house
          marker.on('click', () => {
            renderSingleHouseCard(house);
          });

          window.landingMapMarkers.push(marker);
          bounds.extend([latitude, longitude]);
        }

        if (populateList) {
          boardingHouseList.insertAdjacentHTML('beforeend', createHouseCard(house));
        }
      });

      if (fitMap && window.landingMapMarkers.length > 0) {
        map.fitBounds(bounds, { padding: [50, 50], maxZoom: 16 });
      }

      if (populateList) {
        boardingHouseList.querySelectorAll('.focus-listing').forEach((button) => {
          button.addEventListener('click', () => {
            const latitude = Number(button.dataset.lat);
            const longitude = Number(button.dataset.lng);
            if (Number.isFinite(latitude) && Number.isFinite(longitude)) {
              map.setView([latitude, longitude], 17);
              document.getElementById('landingMap').scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          });
        });
      }
    };

    async function resolvePlace(name, kind) {
      const local = kind === 'institution' && schoolLocations[name.toLowerCase()];
      if (local) return local;
      const response = await fetch('/api/map-place?' + new URLSearchParams({ name, kind }), { cache: 'no-store' });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Location unavailable.');
      return data;
    }

    function displaySearch(focusMap = true) {
      const houses = DormMapSearch.filter(window.allBoardingHousesCache || [], activeCriteria || {});
      renderBoardingHouseMarkers(houses, true, false);
      if (!focusMap) return houses;
      map.stop();
      if (window.institutionMarker) { map.removeLayer(window.institutionMarker); window.institutionMarker = null; }
      if (searchRadiusLayer) { map.removeLayer(searchRadiusLayer); searchRadiusLayer = null; }
      if (activePlace) {
        const point = [activePlace.latitude, activePlace.longitude];
        window.institutionMarker = L.marker(point).addTo(map).bindPopup(escapeHtml(activePlace.name)).openPopup();
        if (activeCriteria?.place) {
          searchRadiusLayer = L.circle(point, { radius: 3000, color: '#047857', fillColor: '#10b981', fillOpacity: 0.06, weight: 1, interactive: false }).addTo(map);
          const area = searchRadiusLayer.getBounds();
          map.fitBounds(area, { padding: [35, 35], maxZoom: 15, animate: false });
        } else map.setView(point, 14, { animate: false });
      } else if (activeCriteria?.barangay && houses.some(DormMapSearch.hasCoordinates)) {
        map.fitBounds(L.latLngBounds(houses.filter(DormMapSearch.hasCoordinates).map(h => [Number(h.latitude), Number(h.longitude)])), { padding: [40, 40], maxZoom: 15, animate: false });
      } else map.fitBounds(municipalityBounds, { padding: [20, 20], animate: false });
      return houses;
    }

    window.performQuickSearch = async function() {
      const version = ++searchVersion;
      let query = document.getElementById('quickSearchQuery')?.value.trim() || '';
      const barangay = document.getElementById('quickBarangaySelect')?.value || '';
      let institution = document.getElementById('quickInstitutionSelect')?.value || '';
      if (!institution && query) {
        const alias = BONGABONG_ALIASES[query.toLowerCase()] || query;
        institution = [...document.getElementById('quickInstitutionSelect').options].find(option => option.value && option.value.toLowerCase() === alias.toLowerCase())?.value || '';
        if (institution) query = '';
      }
      activeCriteria = { query, barangay, type: document.getElementById('quickTypeSelect')?.value || '', priceRange: document.getElementById('quickPriceSelect')?.value || '', radius: 3 };
      activePlace = null;
      searchStatus.textContent = 'Searching places and live listings…';
      let warning = '';
      try {
        if (institution || barangay) {
          const place = await resolvePlace(institution || barangay, institution ? 'institution' : 'barangay');
          if (version !== searchVersion) return;
          activePlace = place;
          if (institution) activeCriteria.place = place;
        }
      } catch (error) {
        if (version !== searchVersion) return;
        warning = error.message;
        // Never silently present municipality-wide results as nearby-school matches.
        if (institution) activeCriteria.query = '__unresolved_institution__';
      }
      if (version !== searchVersion) return;
      const houses = displaySearch();
      searchScope = institution ? ' within 3 km of ' + institution : barangay ? ' in ' + barangay : ' across Bongabong';
      searchWarning = warning;
      searchStatus.textContent = `${houses.length} matching listing(s)${searchScope}. ${searchWarning}`;
      document.getElementById('map')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    // Refresh Map & Filters: Auto center to user's current GPS location & reset listings panel
    window.resetMapAndFilters = function() {
      ++searchVersion; activeCriteria = null; activePlace = null;
      if (searchRadiusLayer) { map.removeLayer(searchRadiusLayer); searchRadiusLayer = null; }
      searchStatus.textContent = 'Filters cleared. Showing all verified boarding house pins.';
      const qInput = document.getElementById('quickSearchQuery');
      const bSelect = document.getElementById('quickBarangaySelect');
      const iSelect = document.getElementById('quickInstitutionSelect');
      const pSelect = document.getElementById('quickPriceSelect');
      const tSelect = document.getElementById('quickTypeSelect');

      if (qInput) qInput.value = '';
      if (bSelect) bSelect.value = '';
      if (iSelect) iSelect.value = '';
      if (pSelect) pSelect.value = '';
      if (tSelect) tSelect.value = '';

      if (window.institutionMarker) {
        map.removeLayer(window.institutionMarker);
        window.institutionMarker = null;
      }

      map.fitBounds(municipalityBounds);

      // 2. Restore all pins on map and default empty state in live listings panel
      if (window.allBoardingHousesCache) {
        renderBoardingHouseMarkers(window.allBoardingHousesCache, false, false);
      }
      renderDefaultListingsPlaceholder();
    };

    document.getElementById('quickSearchQuery')?.addEventListener('keydown', event => {
      if (event.key === 'Enter') { event.preventDefault(); window.performQuickSearch(); }
    });
    for (const id of ['quickInstitutionSelect', 'quickBarangaySelect', 'quickPriceSelect', 'quickTypeSelect']) {
      document.getElementById(id)?.addEventListener('change', () => window.performQuickSearch());
    }

    fetch('/api/institutions').then(response => response.json()).then(institutions => {
      if (!Array.isArray(institutions)) return;
      const select = document.getElementById('quickInstitutionSelect');
      for (const institution of institutions) {
        if (!institution.name) continue;
        if (![...select.options].some(option => option.value.toLowerCase() === institution.name.toLowerCase())) {
          select.add(new Option(institution.name, institution.name));
        }
        if (DormMapSearch.hasCoordinates(institution)) {
          schoolLocations[institution.name.toLowerCase()] = { name: institution.name, latitude: Number(institution.latitude), longitude: Number(institution.longitude) };
        }
      }
    }).catch(() => {});

    let loadingLanding = false;
    let reloadLanding = false;
    async function refreshLanding() {
      if (loadingLanding) { reloadLanding = true; return; }
      loadingLanding = true;
      try {
        const response = await fetch('/api/landing-data', { cache: 'no-store' });
        if (!response.ok) throw new Error('Live data unavailable');
        const data = await response.json();
        window.allBoardingHousesCache = data.listings;
        for (const element of document.querySelectorAll('[data-live-stat]')) {
          const key = element.dataset.liveStat;
          element.textContent = key === 'newHousesThisMonth' ? `+${data.stats[key]} added this month` : Number(data.stats[key]).toLocaleString();
        }
        if (activeCriteria) {
          const matches = displaySearch(false);
          searchStatus.textContent = `${matches.length} matching listing(s)${searchScope}. ${searchWarning}`;
        } else {
          renderBoardingHouseMarkers(data.listings, false, false);
          renderDefaultListingsPlaceholder();
          searchStatus.textContent = `${data.listings.length} listed boarding house(s). Select a school or barangay to explore.`;
        }
        renderTopVerifiedListings(data.listings);
      } catch {
        searchStatus.textContent = 'Live data is temporarily unavailable. Retrying automatically; displayed values may be out of date.';
      } finally {
        loadingLanding = false;
        if (reloadLanding) { reloadLanding = false; refreshLanding(); }
      }
    }
    refreshLanding();
    document.addEventListener('DOMContentLoaded', () => {
      window.DormMapSocket?.on('landing_updated', refreshLanding);
      window.DormMapSocket?.on('connect', refreshLanding);
    });
    setInterval(() => { if (!document.hidden) refreshLanding(); }, 15000);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) refreshLanding(); });

    setTimeout(() => map.invalidateSize(), 250);
    window.addEventListener('resize', () => map.invalidateSize());

    useLocationButton?.addEventListener('click', () => {
      if (!navigator.geolocation) {
        alert('Geolocation is not supported by this browser.');
        return;
      }

      navigator.geolocation.getCurrentPosition(
        (pos) => {
          map.setView([pos.coords.latitude, pos.coords.longitude], 16);
          L.circleMarker([pos.coords.latitude, pos.coords.longitude], {
            radius: 8, color: '#023020', fillColor: '#023020', fillOpacity: 1, weight: 3
          }).addTo(map).bindPopup('Your current location').openPopup();
        },
        () => alert('Location access was denied.'),
        { enableHighAccuracy: true, timeout: 10000 }
      );
    });

    lucide.createIcons();
  </script>
  <script src="/js/landing-translator.js"></script>
  {{> dormigoWidget }}
</body>
</html>
