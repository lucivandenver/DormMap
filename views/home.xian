    <footer id="contact" class="mt-8 w-full px-0 pb-0 pt-0 text-white" style="background: linear-gradient(135deg, #021a10 0%, #023020 60%, #021a10 100%);">
      <div class="w-full px-6 py-12 sm:px-8 lg:px-10">
        <div class="grid gap-10 md:grid-cols-2 xl:grid-cols-4">
          <!-- Brand -->
          <div>
            <div class="flex items-center gap-3 mb-4">
              <div class="h-10 w-10 rounded-full overflow-hidden bg-white/10 border border-white/20 shrink-0">
                <img src="https://bongabong.gov.ph/logo.png" onerror="this.src='/images/bongabong-seal.png'" alt="Bongabong Seal" class="h-full w-full object-contain p-0.5">
              </div>
              <div>
                <p class="font-display text-lg font-extrabold text-white">DormMap</p>
                <p class="text-[10px] font-bold uppercase tracking-wider text-emerald-400">Official BPLO Portal</p>
              </div>
            </div>
            <p class="text-sm leading-7 text-emerald-100/70 max-w-xs">Official BPLO dormitory finder for the Municipality of Bongabong, Oriental Mindoro.</p>
          </div>
          <!-- Quick Links -->
          <div>
            <h4 class="font-black text-white uppercase tracking-wider text-xs mb-4">Quick Links</h4>
            <ul class="space-y-2.5 text-sm text-emerald-100/70">
              <li><a href="#top" class="transition hover:text-white">Home</a></li>
              <li><a href="#map" class="transition hover:text-white">Interactive Map</a></li>
              <li><a href="#search" class="transition hover:text-white">Find Boarding Houses</a></li>
              <li><a href="/about" class="transition hover:text-white">About DormMap</a></li>
              <li><a href="/about#faq" class="transition hover:text-white">Frequently Asked Questions</a></li>
            </ul>
          </div>
          <!-- Government -->
          <div>
            <h4 class="font-black text-white uppercase tracking-wider text-xs mb-4">Government</h4>
            <ul class="space-y-2.5 text-sm text-emerald-100/70">
              <li><a href="https://bongabong.gov.ph" target="_blank" class="transition hover:text-white">Municipality of Bongabong</a></li>
              <li>Business Permit &amp; Licensing Office (BPLO)</li>
              <li>Oriental Mindoro Province</li>
              <li><a href="/about" class="transition hover:text-white">About the Platform</a></li>
            </ul>
          </div>
          <!-- Contact -->
          <div>
            <h4 class="font-black text-white uppercase tracking-wider text-xs mb-4">Contact &amp; Support</h4>
            <ul class="space-y-2.5 text-sm text-emerald-100/70">
              <li class="flex items-center gap-2"><i data-lucide="phone" class="h-3.5 w-3.5 shrink-0 text-emerald-400"></i> (043) 000-0000</li>
              <li class="flex items-center gap-2"><i data-lucide="mail" class="h-3.5 w-3.5 shrink-0 text-emerald-400"></i> bplo@bongabong.gov.ph</li>
              <li class="flex items-start gap-2"><i data-lucide="map-pin" class="h-3.5 w-3.5 shrink-0 text-emerald-400 mt-0.5"></i> Municipal Hall, Bongabong, Oriental Mindoro</li>
            </ul>
          </div>
        </div>
        <div class="mt-10 flex flex-col gap-4 border-t border-white/10 pt-6 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-sm text-emerald-100/50">&copy; 2026 DormMap — Municipality of Bongabong, Oriental Mindoro. All rights reserved.</p>
          <div class="flex items-center gap-3 text-emerald-400">
            <a href="https://bongabong.gov.ph" target="_blank" aria-label="Official Website" class="transition hover:text-white"><i data-lucide="globe" class="h-5 w-5"></i></a>
            <a href="#contact" aria-label="Message" class="transition hover:text-white"><i data-lucide="message-circle" class="h-5 w-5"></i></a>
            <a href="#" aria-label="Share" class="transition hover:text-white"><i data-lucide="share-2" class="h-5 w-5"></i></a>
            <a href="mailto:bplo@bongabong.gov.ph" aria-label="Mail" class="transition hover:text-white"><i data-lucide="mail" class="h-5 w-5"></i></a>
