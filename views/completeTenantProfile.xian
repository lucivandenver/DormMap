{{> head}}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin="" defer></script>
<script src="/js/tenant-registration.js" defer></script>

<body class="tenant-setup">
  <header class="tenant-setup-header">
    <div>
      <a href="/" class="tenant-setup-brand"><span aria-hidden="true">D</span> DormMap</a>
      <a href="/logout" class="tenant-setup-cancel">Cancel &amp; sign out</a>
    </div>
  </header>

  <main class="tenant-setup-main">
    <div class="tenant-setup-card">
      <header class="tenant-setup-intro">
        <p>Step 2 of 2</p>
        <h1>Complete your tenant profile</h1>
        <p>Choose a boarding house, add your contact details, and upload your ID to submit your rental application.</p>
      </header>

      <form id="tenantSetupForm" method="POST" action="/complete-tenant-profile" enctype="multipart/form-data">
        <section class="tenant-setup-section" aria-labelledby="tenantHouseHeading">
          <h2 id="tenantHouseHeading">
            <svg aria-hidden="true" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" viewBox="0 0 24 24"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>
            Boarding house
          </h2>
          <label for="bhSearchInput">Search by name or barangay</label>
          <div class="tenant-setup-search">
            <input type="search" id="bhSearchInput" placeholder="Search boarding houses" aria-controls="bhSelect">
          </div>
          <label for="bhSelect">Target boarding house <span aria-hidden="true">*</span></label>
          <select name="selectedBoardingHouse" id="bhSelect" data-selected="{{values.selectedBoardingHouse}}" required disabled>
            <option value="">Loading boarding houses…</option>
          </select>
          <p id="tenantListingsStatus" class="tenant-setup-hint" role="status"></p>
          <button id="tenantListingsRetry" type="button" class="tenant-setup-cancel" hidden>Retry loading</button>
          <div id="tenantSetupMap" hidden>
            <p class="tenant-setup-hint">You can also choose your boarding house from the map.</p>
            <div id="tenantMiniMap" aria-label="Map of boarding houses"></div>
          </div>
          <label for="roomTypeSelect">Preferred room type</label>
          <select name="requestedRoomType" id="roomTypeSelect" data-selected="{{values.requestedRoomType}}" disabled>
            <option value="">Any room type</option>
          </select>
        </section>

        <section class="tenant-setup-section" aria-labelledby="tenantDetailsHeading">
          <h2 id="tenantDetailsHeading">
            <svg aria-hidden="true" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 22v-2a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v2"/></svg>
            Contact and identification
          </h2>
          <div class="tenant-setup-grid">
            <label for="tenantSetupContact">Contact number <span aria-hidden="true">*</span>
              <input type="tel" id="tenantSetupContact" name="contactNumber" value="{{values.contactNumber}}" required autocomplete="tel" placeholder="09123456789">
            </label>
            <label for="tenantSetupGender">Gender <span aria-hidden="true">*</span>
              <select name="gender" id="tenantSetupGender" data-selected="{{values.gender}}" required>
                <option value="">Select gender</option>
                <option value="male">Male</option>
                <option value="female">Female</option>
                <option value="prefer_not_to_say">Prefer not to say</option>
              </select>
            </label>
            <label for="tenantSetupId">Student or government-issued ID <span aria-hidden="true">*</span>
              <input type="file" id="tenantSetupId" name="validIdPicture" accept="image/jpeg,image/png,image/webp,application/pdf" required>
              <small>JPG, PNG, WebP, or PDF up to 5 MB.</small>
            </label>
            <label for="tenantSetupPicture">Profile picture (optional)
              <input type="file" id="tenantSetupPicture" name="profilePicture" accept="image/jpeg,image/png,image/webp">
              <small>JPG, PNG, or WebP up to 5 MB.</small>
            </label>
          </div>
        </section>

        <label class="tenant-setup-terms">
          <input type="checkbox" name="acceptTerms" value="on" required {{#if values.acceptTerms}}checked{{/if}}>
          <span>I agree to the <a href="https://bstm-9m6x.onrender.com/terms" target="_blank" rel="noopener">Terms &amp; Conditions</a> and <a href="https://bstm-9m6x.onrender.com/privacy" target="_blank" rel="noopener">Privacy Policy</a>.</span>
        </label>
        <p id="tenantSetupError" class="registration-submit-status" data-state="error" role="alert" {{#unless error}}hidden{{/unless}}>{{error}}</p>
        <button class="tenant-setup-submit" type="submit" disabled>
          <svg aria-hidden="true" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="m4 12 5 5L20 6"/></svg>
          <span>Submit application</span>
        </button>
      </form>
    </div>
  </main>
</body>
</html>
