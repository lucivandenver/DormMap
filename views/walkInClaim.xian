{{> head}}
<body class="min-h-screen bg-slate-100 p-4 text-slate-900">
  <main class="mx-auto mt-12 max-w-md space-y-5 rounded-2xl bg-white p-6 shadow-sm sm:p-8">
    <img class="mx-auto size-16 rounded-full" src="/images/dormmap-logo.png" alt="DormMap">
    <h1 class="text-xl font-bold">Set your tenant password</h1>
    <p class="text-sm text-slate-600">Choose a private password for your DormMap account. Your temporary password will expire after this step.</p>
    {{#if error}}<p class="rounded-lg bg-rose-50 p-3 text-sm text-rose-800" role="alert">{{error}}</p>{{/if}}
    <form method="post" action="/claim-walk-in" class="space-y-4">
      <label class="block text-sm font-semibold">New password
        <input type="password" class="mt-1 block w-full rounded-lg border px-3 py-2" name="password" autocomplete="new-password" minlength="8" required>
      </label>
      <label class="block text-sm font-semibold">Confirm new password
        <input type="password" class="mt-1 block w-full rounded-lg border px-3 py-2" name="confirmPassword" autocomplete="new-password" minlength="8" required>
      </label>
      <button class="w-full rounded-lg bg-emerald-800 py-2 font-semibold text-white">Save and open tenant dashboard</button>
    </form>
  </main>
{{> footer}}
