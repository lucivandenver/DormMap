{{> head}}
<script src="/js/password-recovery.js" defer></script>
<body class="bg-slate-100 font-sans text-slate-800">
  <div class="min-h-screen flex flex-col items-center justify-center p-4">
    <div class="w-full max-w-md bg-white rounded-3xl p-8 shadow-xl border border-slate-200/80">
      <div class="text-center mb-6">
        <div class="flex justify-center mb-3">
          <a href="/" class="h-24 w-24 sm:h-28 sm:w-28 rounded-full bg-white border-2 border-emerald-200 shadow-md overflow-hidden flex items-center justify-center p-1 transition hover:scale-105">
            <img src="/images/dormmap-logo.png" alt="DormMap Logo" class="h-full w-full object-contain">
          </a>
        </div>
        <h2 class="text-xl font-bold text-slate-900 mt-2">Set New Password</h2>
        <p class="text-xs text-slate-500 mt-1">Enter and confirm your new password.</p>
      </div>

      {{#if error}}
      <div class="mb-4 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-xs font-semibold text-rose-700 leading-relaxed" data-feedback-on-load="error">{{error}}</div>
      {{/if}}

      {{#if success}}
      <div class="mb-4 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-xs font-semibold text-emerald-800 leading-relaxed" data-feedback-on-load="success">{{success}}</div>
      {{/if}}

      {{#if token}}
      <form data-password-recovery method="POST" action="/reset-password" class="space-y-4">
        <input type="hidden" name="token" value="{{token}}">

        <div>
          <label for="recovery-password" class="block text-xs font-bold text-slate-700 mb-1">New Password</label>
          <input type="password" autocomplete="new-password" id="recovery-password" name="password" minlength="6" placeholder="Minimum 6 characters" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-xs focus:border-emerald-700 focus:bg-white focus:outline-none focus:ring-4 focus:ring-emerald-900/10" required>
        </div>

        <div>
          <label for="recovery-confirmPassword" class="block text-xs font-bold text-slate-700 mb-1">Confirm New Password</label>
          <input type="password" autocomplete="new-password" id="recovery-confirmPassword" name="confirmPassword" minlength="6" placeholder="Repeat new password" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-xs focus:border-emerald-700 focus:bg-white focus:outline-none focus:ring-4 focus:ring-emerald-900/10" required>
        </div>

        <p data-recovery-status role="status" class="text-sm text-slate-700"></p>
        <button type="submit" class="w-full rounded-2xl bg-emerald-800 py-3 text-sm font-bold text-white shadow-lg shadow-emerald-800/20 hover:bg-emerald-900 transition active:scale-98">
          Update Password
        </button>
      </form>
      {{/if}}

      <div class="flex items-center justify-between text-center mt-6 pt-4 border-t border-slate-100 text-xs">
        <a href="/forgot-password" class="font-semibold text-slate-500 hover:text-slate-800">← Request New Link</a>
        <a href="/login" class="font-bold text-emerald-800 hover:underline">Back to Login →</a>
      </div>
    </div>
  </div>
{{> footer}}
