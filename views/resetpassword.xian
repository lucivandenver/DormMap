{{> head}}
<body class="bg-slate-100 font-sans text-slate-800">
  <div class="min-h-screen flex flex-col items-center justify-center p-4">
    <div class="w-full max-w-md bg-white rounded-3xl p-8 shadow-xl border border-slate-200/80">
      <div class="text-center mb-6">
        <div class="flex justify-center mb-3">
          <a href="/" class="h-24 w-24 sm:h-28 sm:w-28 rounded-full bg-white border-2 border-emerald-200 shadow-md overflow-hidden flex items-center justify-center p-1 transition hover:scale-105">
            <img src="/images/dormmap-logo.png" alt="DormMap Logo" class="h-full w-full object-contain">
          </a>
        </div>
        <h2 class="text-xl font-bold text-slate-900 mt-2">Set New Password</h2>
        <p class="text-xs text-slate-500 mt-1">Enter your 6-digit verification code and your new password.</p>
      </div>

      {{#if error}}
      <div class="mb-4 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-xs font-semibold text-rose-700 leading-relaxed">{{error}}</div>
      {{/if}}

      {{#if success}}
      <div class="mb-4 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-xs font-semibold text-emerald-800 leading-relaxed">{{success}}</div>
      {{/if}}

      <form method="POST" action="/reset-password" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Registered Email</label>
          <input type="email" name="email" value="{{email}}" placeholder="user@gmail.com" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-xs focus:border-emerald-700 focus:bg-white focus:outline-none focus:ring-4 focus:ring-emerald-900/10 font-semibold" required>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">6-Digit Verification Code</label>
          <input type="text" name="otp" value="{{token}}" maxlength="6" pattern="[0-9]{6}" placeholder="123456" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-center font-mono text-base font-extrabold tracking-[0.4em] focus:border-emerald-700 focus:outline-none focus:ring-4 focus:ring-emerald-900/10" required>
          <p class="text-[11px] text-slate-400 mt-1 text-center">Found in your email inbox or spam folder (valid for 15 minutes).</p>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">New Password</label>
          <input type="password" name="password" minlength="6" placeholder="Minimum 6 characters" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-xs focus:border-emerald-700 focus:bg-white focus:outline-none focus:ring-4 focus:ring-emerald-900/10" required>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Confirm New Password</label>
          <input type="password" name="confirmPassword" minlength="6" placeholder="Repeat new password" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-xs focus:border-emerald-700 focus:bg-white focus:outline-none focus:ring-4 focus:ring-emerald-900/10" required>
        </div>

        <button type="submit" class="w-full rounded-2xl bg-emerald-800 py-3 text-sm font-bold text-white shadow-lg shadow-emerald-800/20 hover:bg-emerald-900 transition active:scale-98">
          Update Password
        </button>
      </form>

      <div class="flex items-center justify-between text-center mt-6 pt-4 border-t border-slate-100 text-xs">
        <a href="/forgot-password" class="font-semibold text-slate-500 hover:text-slate-800">← Request New Code</a>
        <a href="/login" class="font-bold text-emerald-800 hover:underline">Back to Login →</a>
      </div>
    </div>
  </div>
{{> footer}}
