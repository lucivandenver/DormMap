<script src="/js/tenant-registration.js?v=4" defer></script>
<div class="registration-property" data-registration-property>
  <label for="registrationHouseSearch">Search boarding house <small>(optional)</small></label>
  <div class="registration-property-search">
    <input type="search" id="registrationHouseSearch" data-house-search autocomplete="off"
      placeholder="Search by name or barangay" aria-controls="registrationHouseResults">
    <button type="button" data-search-houses class="registration-search-button">
      <svg aria-hidden="true" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
      Search
    </button>
  </div>
  <p class="registration-property-hint" data-house-status role="status" hidden></p>
  <ul id="registrationHouseResults" class="registration-house-results" data-house-results aria-label="Boarding house search results" hidden></ul>
  <button type="button" class="registration-text-button" data-retry-houses hidden>Retry loading boarding houses</button>

  <p class="registration-property-hint">Tap a map pin or use search to view details and select a boarding house. You can also choose one later.</p>
  <div class="registration-property-map" data-house-map role="region" aria-label="Map of boarding houses"></div>
  <p class="registration-property-hint" data-map-unavailable hidden>The map could not load. You can still use search.</p>

  <input type="hidden" name="selectedBoardingHouse" value="{{selection.selectedBoardingHouse}}">
  <div class="registration-house-selection" data-house-selection hidden>
    <img data-selected-photo alt="" hidden>
    <div class="registration-selected-copy">
      <span class="registration-property-hint">Selected boarding house</span>
      <strong data-house-name aria-live="polite"></strong>
      <button type="button" class="registration-text-button" data-selected-details>View details</button>
    </div>
    <button type="button" class="registration-text-button" data-clear-house>Clear</button>
  </div>
  <label data-room-preference hidden>Preferred room <small>(optional)</small>
    <select name="requestedRoomId" data-selected="{{selection.requestedRoomId}}" aria-describedby="registrationRoomHint" disabled>
      <option value="">No preference</option>
    </select>
    <small id="registrationRoomHint" class="registration-property-hint">Choose an available room to share a preference or request an optional reservation.</small>
  </label>
  {{> reservationFields selection=selection}}
  <dialog class="dormmap-property-dialog registration-property-details" data-registration-details aria-labelledby="registrationListingName">
    <header class="registration-details-header">
      <h2 id="registrationListingName" data-details-name></h2>
      <button type="button" class="registration-search-button" data-close-details>Close</button>
    </header>
    <div class="registration-details-content">
      <div data-details-photos class="registration-details-photos"></div>
      <p class="registration-property-hint" data-details-address></p>
      <p data-details-summary></p>
      <p data-details-description></p>
      <dl data-details-prices class="registration-details-prices"></dl>
      <div data-details-amenities hidden><h3>Amenities</h3><ul></ul></div>
      <div data-details-rooms></div>
      <button type="button" class="registration-select-house" data-select-details>Select boarding house</button>
    </div>
  </dialog>
</div>
