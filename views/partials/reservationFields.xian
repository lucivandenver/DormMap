<fieldset data-reservation class="mt-3 space-y-3 rounded-xl border border-emerald-200 bg-emerald-50/60 p-3 text-sm" {{#if forced}}data-reservation-forced{{/if}} hidden>
  <label class="flex items-start gap-2 font-semibold text-emerald-950" {{#if forced}}hidden{{/if}}>
    <input type="checkbox" name="reserveRoom" data-reserve-toggle {{#if selection.reserveRoom}}checked{{/if}}>
    Request a reservation (optional) · 10% fee
  </label>
  <div class="space-y-3" data-reserve-details hidden>
    <p class="font-semibold text-emerald-950" data-reserve-fee></p>
    <p class="text-slate-600">The owner checks your payment before holding this room or slot. Accept the approved offer to confirm your tenancy.</p>
    <input type="hidden" name="reservationFee" data-reserve-amount>
    <label class="block font-semibold">Amount paid (₱)
      <input type="number" name="reservationPaidAmount" data-reserve-paid-amount value="{{selection.reservationPaidAmount}}" inputmode="decimal" min="0.01" max="99999999.99" step="0.01" class="mt-1 block w-full rounded-lg border border-slate-300 bg-white p-2" disabled>
    </label>
    <label class="block font-semibold" data-reserve-method-label>Payment method
      <select name="reservationMethod" data-reserve-method data-initial-method="{{selection.reservationMethod}}" class="mt-1 block w-full rounded-lg border border-slate-300 bg-white p-2"></select>
    </label>
    <p data-reserve-cash hidden>Pay the reservation fee to the owner in person. The request stays pending until the owner verifies receipt.</p>
    <div class="space-y-2" data-reserve-qr-fields hidden>
      <img data-reserve-qr class="mx-auto h-36 max-w-full rounded-lg bg-white object-contain" alt="Owner’s reservation payment QR code" hidden>
      <label class="block font-semibold">Transaction reference
        <input name="reservationReference" data-reserve-reference value="{{selection.reservationReference}}" class="mt-1 block w-full rounded-lg border border-slate-300 bg-white p-2" autocomplete="off">
      </label>
      <small class="text-slate-600" data-reserve-reference-hint></small>
    </div>
    <label class="block font-semibold" data-reserve-proof-label>Proof of payment <span data-reserve-proof-optional class="font-normal">(optional for cash)</span>
      <input type="file" name="reservationProof" data-reserve-proof accept="image/jpeg,image/png,image/webp" class="mt-1 block w-full text-xs" disabled>
    </label>
    <p data-reserve-status role="status" class="text-slate-700" hidden></p>
    <button type="button" data-reserve-retry class="font-semibold text-emerald-800 underline" hidden>Reload payment options</button>
  </div>
</fieldset>
