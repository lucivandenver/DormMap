<div data-owner-counts>
  <label>Branches including the main property<input type="number" name="declaredBranches" min="1" max="100" required value="{{authValues.declaredBranches}}"></label>
  <fieldset>
    <legend>Main property</legend>
    <div class="owner-count-grid">
      <label>Floors<input type="number" name="floorCount" min="1" max="50" required value="{{authValues.floorCount}}"></label>
      <label>Rooms<input type="number" name="roomsAvailable" min="1" max="100" required value="{{authValues.roomsAvailable}}"></label>
    </div>
  </fieldset>
  <div data-additional-branches></div>
</div>
